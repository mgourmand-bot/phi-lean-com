---
/**
 * Logo officiel Phi-Lean (PNG d'origine, jamais redessiné).
 * Sur fond sombre, il est posé sur une pastille blanche : le « -Lean »
 * anthracite resterait sinon illisible.
 */
import { site } from '@/config/site';

interface Props {
  height?: number; // hauteur affichée en px
  inverted?: boolean;
  class?: string;
  eager?: boolean;
}
const { height = 52, inverted = false, class: className = '', eager = false } = Astro.props;
const width = Math.round((height * site.logo.width) / site.logo.height);
---
<img
  src={site.logo.src}
  width={width}
  height={height}
  alt={`${site.name} – ${site.tagline}`}
  class:list={['block', className, inverted && 'box-content rounded-[var(--radius-pl)] bg-white px-3 py-2']}
  style={`height:${height}px;width:auto`}
  decoding="async"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
/>
