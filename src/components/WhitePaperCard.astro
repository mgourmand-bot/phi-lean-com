---
/**
 * White paper contre adresse e-mail.
 * Le formulaire s'ouvre dans la carte ; après envoi réussi, le lien de
 * téléchargement apparaît. Pour un accès strictement réservé, faites envoyer
 * le lien par e-mail depuis le webhook (voir README).
 */
import FormShell from './forms/FormShell.astro';
import Icon from './ui/Icon.astro';
import { site } from '@/config/site';
import type { WhitePaper } from '@/data/publications';
import type { Lang } from '@/i18n/routes';
import { publicFileExists } from '@/lib/files';

interface Props {
  paper: WhitePaper;
  lang: Lang;
}
const { paper, lang } = Astro.props;
const fr = lang === 'fr';
const available = publicFileExists(paper.file);
const formId = `wp-${paper.id}`;
---
<article class="flex h-full flex-col border border-bordure border-t-[6px] border-t-turquoise bg-white p-6" data-whitepaper>
  <p class="text-sm text-gris">White paper, {paper.pages} pages</p>
  <h3 class="mt-2 text-lg font-bold text-anthracite">{paper.title[lang]}</h3>
  <p class="mt-2 text-[0.97rem] text-anthracite/85">{paper.summary[lang]}</p>

  <details class="group mt-auto pt-5">
    <summary class="btn btn-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <Icon name="download" size={18} />
      {fr ? 'Recevoir le PDF' : 'Get the PDF'}
    </summary>
    <div class="mt-5">
      <FormShell
        id={formId}
        endpoint={site.forms.whitepaper}
        lang={lang}
        subject={`White paper – ${paper.title.fr}`}
        submitLabel={fr ? 'Accéder au white paper' : 'Access the white paper'}
        successMessage={available
          ? fr ? 'Merci, votre white paper est prêt.' : 'Thank you, your white paper is ready.'
          : fr ? 'Merci, nous vous l’envoyons par e-mail dès sa parution.' : 'Thank you, we will e-mail it to you as soon as it is published.'}
      >
        <input type="hidden" name="ressource" value={paper.id} />
        <div>
          <label for={`${formId}-email`} class="field-label">{fr ? 'E-mail professionnel' : 'Work e-mail'} *</label>
          <input id={`${formId}-email`} name="email" type="email" autocomplete="email" required class="field" />
        </div>
        <div>
          <label for={`${formId}-company`} class="field-label">{fr ? 'Entreprise' : 'Company'} *</label>
          <input id={`${formId}-company`} name="entreprise" type="text" autocomplete="organization" required class="field" />
        </div>
      </FormShell>
      {available && (
        <a href={paper.file} download class="btn btn-primary mt-4 hidden" data-download>
          <Icon name="download" size={18} />
          {fr ? 'Télécharger le PDF' : 'Download the PDF'}
        </a>
      )}
    </div>
  </details>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-whitepaper]').forEach((card) => {
    card.addEventListener('pl:form-success', () => {
      card.querySelector<HTMLElement>('[data-download]')?.classList.remove('hidden');
    });
  });
</script>
