---
/**
 * En-tête : logo, menus déroulants, passerelle Phi-Lean.ai, FR|EN, « Prendre RDV ».
 * - Ordinateur (≥ 1280 px) : le sous-menu apparaît au survol ou au clavier (Tab).
 *   Clic sur le menu = page principale ; clic sur un sous-menu = section dédiée.
 * - Mobile et tablette : panneau avec menus et sous-menus dépliés.
 */
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { site } from '@/config/site';
import { navigation, childHref } from '@/config/navigation';
import { routes, type Lang, type RouteKey } from '@/i18n/routes';
import { useTranslations, anchorPath } from '@/i18n/utils';

interface Props {
  lang: Lang;
  routeKey?: RouteKey;
}
const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);
const meetingHref = anchorPath('contact', 'meeting', lang);
---
<header class="sticky top-0 z-40 border-b border-bordure bg-white">
  <div class="stripe-tri" aria-hidden="true"></div>
  <div class="container-pl flex h-[5rem] items-center justify-between gap-6">
    <a href={routes.home[lang]} class="shrink-0" aria-label={`${site.name}, ${lang === 'fr' ? 'accueil' : 'home'}`}>
      <Logo height={56} eager />
    </a>

    <nav aria-label={t('nav.main')} class="hidden xl:block" data-desktop-nav>
      <ul class="flex items-center">
        {navigation.map((item) => {
          const active = routeKey !== undefined && item.activeFor.includes(routeKey);
          return (
            <li class="group relative">
              <a
                href={routes[item.route][lang]}
                aria-current={routeKey === item.route ? 'page' : undefined}
                class:list={[
                  'relative flex items-center gap-1 whitespace-nowrap px-3 py-2 text-[0.95rem] font-bold transition-colors',
                  active ? 'text-bleu' : 'text-anthracite hover:text-bleu',
                  'after:absolute after:inset-x-3 after:-bottom-[1.15rem] after:h-[3px]',
                  active ? 'after:bg-turquoise' : 'after:bg-transparent',
                ]}
              >
                {item.label[lang]}
                <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true" class="mt-0.5 text-gris transition-transform duration-150 group-hover:rotate-180 group-focus-within:rotate-180">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <div
                class="invisible absolute top-full left-0 z-50 pt-[1.1rem] opacity-0 transition duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
                data-submenu
              >
                <ul class="w-[19rem] border border-bordure border-t-[3px] border-t-turquoise bg-white py-2 shadow-[0_14px_28px_-14px_rgba(19,58,94,0.45)]">
                  {item.children.map((child) => (
                    <li>
                      <a href={childHref(child, lang)} class="block px-5 py-2.5 hover:bg-ciel focus-visible:bg-ciel">
                        <span class="block font-bold text-anthracite">{child.label[lang]}</span>
                        {child.hint && <span class="mt-0.5 block text-sm text-gris">{child.hint[lang]}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="hidden items-center gap-4 xl:flex">
      <a
        href={site.aiUrl}
        target="_blank"
        rel="noopener"
        title={t('nav.aiTitle')}
        class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-[var(--radius-pl)] border border-bordure px-3 py-2 text-sm font-bold text-bleu hover:border-bleu hover:bg-ciel"
      >
        <Icon name="bolt" size={16} class="text-soleil" />
        {t('nav.ai')}
      </a>
      <LanguageSwitcher lang={lang} routeKey={routeKey} />
      <a href={meetingHref} class="btn btn-primary">
        <Icon name="calendar" size={18} />
        {t('cta.meeting')}
      </a>
    </div>

    <!-- Mobile / tablette -->
    <div class="flex items-center gap-3 xl:hidden">
      <a href={meetingHref} class="btn btn-primary hidden px-4 sm:inline-flex">{t('cta.meeting')}</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[var(--radius-pl)] border border-bordure text-bleu"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
        aria-label={t('nav.menu')}
      >
        <span data-icon-open><Icon name="menu" size={22} /></span>
        <span data-icon-close hidden><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="max-h-[calc(100dvh-5.4rem)] overflow-y-auto border-t border-bordure bg-white xl:hidden" hidden>
    <nav aria-label={t('nav.main')} class="container-pl py-3">
      <ul class="divide-y divide-bordure">
        {navigation.map((item) => (
          <li class="py-3">
            <a
              href={routes[item.route][lang]}
              aria-current={routeKey === item.route ? 'page' : undefined}
              class:list={['block py-1 text-lg font-bold', routeKey !== undefined && item.activeFor.includes(routeKey) ? 'text-bleu' : 'text-anthracite']}
            >
              {item.label[lang]}
            </a>
            <ul class="mt-1 border-l-2 border-turquoise pl-4">
              {item.children.map((child) => (
                <li>
                  <a href={childHref(child, lang)} class="block py-1.5 text-[0.97rem] text-anthracite/85 hover:text-bleu">{child.label[lang]}</a>
                </li>
              ))}
            </ul>
          </li>
        ))}
        <li class="py-3">
          <a href={routes.contact[lang]} class="block py-1 text-lg font-bold text-anthracite">{t('nav.contact')}</a>
        </li>
      </ul>
      <div class="mt-4 flex flex-wrap items-center gap-4 pb-2">
        <a href={meetingHref} class="btn btn-primary">
          <Icon name="calendar" size={18} />
          {t('cta.meeting')}
        </a>
        <a href={site.aiUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-bold text-bleu">
          <Icon name="bolt" size={16} class="text-soleil" />
          {t('nav.ai')}
        </a>
        <LanguageSwitcher lang={lang} routeKey={routeKey} class="ml-auto" />
      </div>
    </nav>
  </div>
</header>

<script>
  // Menu mobile
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const isOpen = () => !panel.hasAttribute('hidden');
    const setOpen = (open: boolean) => {
      panel.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      toggle.querySelector<HTMLElement>('[data-icon-open]')?.toggleAttribute('hidden', open);
      toggle.querySelector<HTMLElement>('[data-icon-close]')?.toggleAttribute('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    // Un clic sur un lien d'ancre de la même page referme le panneau
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }

  // Sous-menus (ordinateur) : Échap referme le menu ouvert au clavier
  const desktopNav = document.querySelector<HTMLElement>('[data-desktop-nav]');
  desktopNav?.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const item = (e.target as HTMLElement).closest('li.group');
    const trigger = item?.querySelector<HTMLAnchorElement>(':scope > a');
    trigger?.focus();
    trigger?.blur();
  });
</script>
