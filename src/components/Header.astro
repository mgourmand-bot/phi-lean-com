---
/**
 * En-tête : logo, menu, passerelle Phi-Lean.ai, sélecteur FR|EN, CTA « Prendre RDV ».
 * Menu complet à partir de 1280 px, panneau déroulant en dessous.
 */
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { site } from '@/config/site';
import { routes, type Lang, type RouteKey } from '@/i18n/routes';
import { useTranslations, path } from '@/i18n/utils';
import type { UiKey } from '@/i18n/ui';

interface Props {
  lang: Lang;
  routeKey?: RouteKey;
}
const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

const nav: { key: RouteKey; label: UiKey }[] = [
  { key: 'consulting', label: 'nav.consulting' },
  { key: 'training', label: 'nav.training' },
  { key: 'games', label: 'nav.games' },
  { key: 'publications', label: 'nav.publications' },
  { key: 'about', label: 'nav.about' },
];
const meetingHref = path('contact', lang, '#rdv');
---
<header class="sticky top-0 z-40 border-b border-bordure bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/90">
  <div class="stripe-tri" aria-hidden="true"></div>
  <div class="container-pl flex h-[4.75rem] items-center justify-between gap-6">
    <a href={routes.home[lang]} class="shrink-0" aria-label={`${site.name}, ${lang === 'fr' ? 'accueil' : 'home'}`}>
      <Logo height={44} />
    </a>

    <nav aria-label={t('nav.main')} class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => {
          const active = routeKey === item.key;
          return (
            <li>
              <a
                href={routes[item.key][lang]}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'relative block whitespace-nowrap px-2.5 py-2 text-[0.95rem] font-bold transition-colors',
                  active ? 'text-bleu' : 'text-anthracite hover:text-bleu',
                  'after:absolute after:inset-x-2.5 after:-bottom-[1.05rem] after:h-[3px]',
                  active ? 'after:bg-turquoise' : 'after:bg-transparent',
                ]}
              >
                {t(item.label)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="hidden items-center gap-4 xl:flex">
      <a
        href={site.aiUrl}
        target="_blank"
        rel="noopener"
        title={t('nav.aiTitle')}
        class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-[var(--radius-pl)] border border-bordure px-3 py-2 text-sm font-bold text-bleu hover:border-bleu hover:bg-ciel"
      >
        <Icon name="bolt" size={16} class="text-soleil" />
        {t('nav.ai')}
      </a>
      <LanguageSwitcher lang={lang} routeKey={routeKey} />
      <a href={meetingHref} class="btn btn-primary">
        <Icon name="calendar" size={18} />
        {t('cta.meeting')}
      </a>
    </div>

    <!-- Mobile / tablette -->
    <div class="flex items-center gap-3 xl:hidden">
      <a href={meetingHref} class="btn btn-primary hidden px-4 sm:inline-flex">{t('cta.meeting')}</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[var(--radius-pl)] border border-bordure text-bleu"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
        aria-label={t('nav.menu')}
      >
        <span data-icon-open><Icon name="menu" size={22} /></span>
        <span data-icon-close hidden><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="border-t border-bordure bg-white xl:hidden" hidden>
    <nav aria-label={t('nav.main')} class="container-pl py-4">
      <ul class="divide-y divide-bordure">
        {nav.map((item) => (
          <li>
            <a
              href={routes[item.key][lang]}
              aria-current={routeKey === item.key ? 'page' : undefined}
              class:list={[
                'flex py-3.5 text-lg font-bold',
                routeKey === item.key ? 'text-bleu' : 'text-anthracite',
              ]}
            >
              {t(item.label)}
            </a>
          </li>
        ))}
        <li>
          <a href={routes.careers[lang]} class="flex py-3.5 text-lg font-bold text-anthracite">{t('nav.careers')}</a>
        </li>
      </ul>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <a href={meetingHref} class="btn btn-primary">
          <Icon name="calendar" size={18} />
          {t('cta.meeting')}
        </a>
        <a href={site.aiUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-bold text-bleu">
          <Icon name="bolt" size={16} class="text-soleil" />
          {t('nav.ai')}
        </a>
        <LanguageSwitcher lang={lang} routeKey={routeKey} class="ml-auto" />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      toggle.querySelector<HTMLElement>('[data-icon-open]')!.hidden = open;
      toggle.querySelector<HTMLElement>('[data-icon-close]')!.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hasAttribute('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
