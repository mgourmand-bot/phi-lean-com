---
/**
 * Pied de page : présentation, bases (Liverdun, Royal Tunbridge Wells),
 * plan du site issu des menus, mentions légales / RGPD, lien Português.
 */
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { site } from '@/config/site';
import { navigation, childHref } from '@/config/navigation';
import { routes, portugueseRoute, type Lang, type RouteKey, type LangHrefs } from '@/i18n/routes';
import { useTranslations, anchorPath } from '@/i18n/utils';

interface Props {
  lang: Lang;
  routeKey?: RouteKey;
  langHrefs?: LangHrefs;
}
const { lang, routeKey, langHrefs } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const columns = navigation.map((item) => ({
  title: item.label[lang],
  href: routes[item.route][lang],
  links: [
    ...item.children.map((child) => ({ href: childHref(child, lang), label: child.label[lang] })),
    ...(item.route === 'consulting'
      ? [{ href: anchorPath('consulting', 'vsmExpress', lang), label: lang === 'fr' ? 'Diagnostic VSM Express' : 'VSM Express Diagnostic' }]
      : []),
    ...(item.route === 'about' ? [{ href: routes.contact[lang], label: t('nav.contact') }] : []),
  ],
}));
---
<footer class="on-dark mt-auto bg-bleu-nuit text-white">
  <div class="stripe-tri box-content border-t-[3px] border-white" aria-hidden="true"></div>
  <div class="container-pl grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-[1.5fr_repeat(5,1fr)]">
    <div class="max-w-sm sm:col-span-2 lg:col-span-3 xl:col-span-1">
      <Logo height={46} inverted />
      <p class="mt-5 text-[0.95rem] text-white/80">{t('footer.pitch')}</p>
      <p class="mt-5 text-sm font-bold text-white/60">{t('footer.offices')}</p>
      <ul class="mt-2 space-y-1 text-[0.95rem]">
        {site.offices.map((o) => (
          <li><span class="font-bold">{o.city}</span> <span class="text-white/70">({o.region[lang]})</span></li>
        ))}
      </ul>
      <div class="mt-5 flex flex-col gap-2.5">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-sm font-bold text-white hover:underline">
          <Icon name="mail" size={18} />
          {site.email}
        </a>
        <a href={site.aiUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-bold text-white/90 hover:text-white hover:underline">
          <Icon name="bolt" size={16} class="text-soleil" />
          {t('nav.ai')}
        </a>
      </div>
    </div>

    {columns.map((col) => (
      <div>
        <h2 class="text-sm font-bold"><a href={col.href} class="text-white/60 hover:text-white hover:underline">{col.title}</a></h2>
        <ul class="mt-4 space-y-2.5">
          {col.links.map((link) => (
            <li>
              <a href={link.href} class="text-[0.95rem] text-white hover:underline hover:underline-offset-4">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-white/15">
    <div class="container-pl flex flex-col gap-4 py-6 text-sm text-white/65 md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {site.name} – The True <em>Philosophie</em> of Lean. {t('footer.rights')}
      </p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li><a href={routes.legal[lang]} class="hover:text-white hover:underline">{t('footer.legal')}</a></li>
        <li><a href={routes.privacy[lang]} class="hover:text-white hover:underline">{t('footer.privacy')}</a></li>
        <li><LanguageSwitcher lang={lang} routeKey={routeKey} hrefs={langHrefs} tone="dark" /></li>
        <li>
          <a href={portugueseRoute} hreflang="pt" lang="pt" class="text-white/50 hover:text-white hover:underline">{t('footer.pt')}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
