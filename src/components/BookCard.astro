---
/**
 * Livre Phi-Lean Press. Sans couverture fournie, une couverture
 * typographique aux couleurs de la charte est générée en CSS.
 */
import Icon from './ui/Icon.astro';
import type { Book } from '@/data/publications';
import type { Lang } from '@/i18n/routes';
import { publicFileExists } from '@/lib/files';

interface Props {
  book: Book;
  lang: Lang;
  compact?: boolean;
}
const { book, lang, compact = false } = Astro.props;
const fr = lang === 'fr';
const amazon = book.amazonUrl[lang] || book.amazonUrl.fr;
const hasCover = publicFileExists(book.cover);
const toneBg = { blue: 'bg-bleu', turq: 'bg-turquoise-fonce', sun: 'bg-soleil-fonce' }[book.tone];
---
<article class="flex h-full flex-col">
  <div class="relative aspect-[2/3] w-full max-w-[15rem] overflow-hidden shadow-[6px_6px_0_var(--color-bordure)]">
    {hasCover ? (
      <img src={book.cover} alt={fr ? `Couverture : ${book.title[lang]}` : `Cover: ${book.title[lang]}`} class="h-full w-full object-cover" loading="lazy" decoding="async" />
    ) : (
      <div class:list={['flex h-full flex-col justify-between p-5 text-white', toneBg]} aria-hidden="true">
        <span class="text-xs font-bold text-white/80">Phi-Lean Press</span>
        <div>
          <div class="mb-4 h-1 w-10 bg-white/80"></div>
          <p class="text-xl font-bold leading-tight">{book.title[lang]}</p>
        </div>
        <span class="text-sm text-white/85">Manuel Gourmand</span>
      </div>
    )}
  </div>
  <div class="mt-6 flex flex-1 flex-col">
    {book.placeholder && (
      <p class="mb-2 inline-flex w-fit bg-creme px-2 py-0.5 text-xs font-bold text-soleil-fonce">{book.subtitle[lang]}</p>
    )}
    <h3 class="text-lg font-bold text-anthracite">{book.title[lang]}</h3>
    {!compact && <p class="mt-2 text-[0.97rem] text-anthracite/85">{book.summary[lang]}</p>}
    <div class="mt-auto pt-4">
      {amazon ? (
        <a href={amazon} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-bold text-bleu hover:underline">
          <Icon name="book" size={18} />
          {fr ? 'Voir sur Amazon' : 'View on Amazon'}
          <span class="sr-only">{fr ? '(nouvel onglet)' : '(opens in a new tab)'}</span>
        </a>
      ) : (
        <p class="inline-flex items-center gap-1.5 text-sm font-bold text-gris">
          <Icon name="book" size={18} />
          {fr ? 'Parution prochaine sur Amazon' : 'Coming soon on Amazon'}
        </p>
      )}
    </div>
  </div>
</article>
