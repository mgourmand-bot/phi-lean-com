---
/**
 * Schémas conceptuels des serious games (pas de photos nécessaires).
 * beer-game : l'effet coup de fouet, la variation des commandes grandit en remontant la chaîne.
 * lean-coffee-shop : flux poussé (piles d'en-cours) contre flux tiré (une pièce entre postes).
 */
import type { Lang } from '@/i18n/routes';

interface Props {
  game: 'beer-game' | 'lean-coffee-shop';
  lang: Lang;
}
const { game, lang } = Astro.props;
const fr = lang === 'fr';

const links = fr ? ['Détaillant', 'Grossiste', 'Distributeur', 'Brasserie'] : ['Retailer', 'Wholesaler', 'Distributor', 'Brewery'];
const amplitudes = [3, 8, 14, 22];
const colors = ['var(--color-turquoise)', 'var(--color-bleu)', 'var(--color-soleil)', 'var(--color-corail)'];
const wave = (amp: number, y: number) => {
  const pts: string[] = [];
  for (let x = 0; x <= 260; x += 4) {
    const v = Math.sin(x / 18) * amp * (0.6 + 0.4 * Math.sin(x / 47));
    pts.push(`${130 + x},${(y + v).toFixed(1)}`);
  }
  return pts.join(' ');
};

const stations = [0, 1, 2, 3];
---
{game === 'beer-game' ? (
  <svg
    viewBox="0 0 400 240"
    role="img"
    aria-label={fr ? 'Effet coup de fouet : la variation des commandes augmente du détaillant vers la brasserie.' : 'Bullwhip effect: order variability grows from retailer to brewery.'}
    class="h-auto w-full"
    font-family="Arial, Helvetica, sans-serif"
  >
    {links.map((label, i) => {
      const y = 36 + i * 54;
      return (
        <g>
          <text x="0" y={y + 5} font-size="14" font-weight="700" fill="var(--color-anthracite)">{label}</text>
          <line x1="130" y1={y} x2="390" y2={y} stroke="var(--color-bordure)" stroke-width="1" />
          <polyline points={wave(amplitudes[i], y)} fill="none" stroke={colors[i]} stroke-width="2.5" stroke-linejoin="round" />
        </g>
      );
    })}
  </svg>
) : (
  <svg
    viewBox="0 0 400 220"
    role="img"
    aria-label={fr ? 'Flux poussé avec des piles d’en-cours entre les postes, puis flux tiré avec une seule commande entre chaque poste.' : 'Push flow with piles of work-in-progress between stations, then pull flow with a single order between stations.'}
    class="h-auto w-full"
    font-family="Arial, Helvetica, sans-serif"
  >
    {[{ y: 20, label: fr ? 'Flux poussé' : 'Push flow', pile: [4, 6, 3] }, { y: 125, label: fr ? 'Flux tiré' : 'Pull flow', pile: [1, 1, 1] }].map((row, r) => (
      <g>
        <text x="0" y={row.y + 12} font-size="14" font-weight="700" fill={r === 0 ? 'var(--color-soleil-fonce)' : 'var(--color-turquoise-fonce)'}>{row.label}</text>
        {stations.map((s) => (
          <rect x={10 + s * 104} y={row.y + 26} width="64" height="44" fill="var(--color-bleu)" />
        ))}
        {row.pile.map((count, gap) =>
          Array.from({ length: count }).map((_, k) => (
            <circle
              cx={88 + gap * 104 + (k % 2) * 11}
              cy={row.y + 62 - Math.floor(k / 2) * 12}
              r="5"
              fill={r === 0 ? 'var(--color-creme)' : 'var(--color-menthe)'}
              stroke={r === 0 ? 'var(--color-soleil)' : 'var(--color-turquoise)'}
              stroke-width="2"
            />
          ))
        )}
      </g>
    ))}
  </svg>
)}
