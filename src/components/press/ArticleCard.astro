---
/**
 * Article en libre accès : vignette de première page (clic = téléchargement
 * direct, sans formulaire) et, à côté, la date bien visible, un résumé
 * d'accroche et le lien vers la page de l'article (à partager).
 */
import Icon from '../ui/Icon.astro';
import DocCover from './DocCover.astro';
import { formatPubDate, type Article } from '@/data/publications';
import type { Lang } from '@/i18n/routes';
import { publicationPath } from '@/i18n/slugs';
import { publicFileExists } from '@/lib/files';

interface Props {
  article: Article;
  lang: Lang;
  tone?: 'blue' | 'turq' | 'sun';
}
const { article, lang, tone = 'blue' } = Astro.props;
const fr = lang === 'fr';
const hasFile = publicFileExists(article.file);
const hasThumb = publicFileExists(article.thumb);
const thumb2x = article.thumb?.replace(/\.webp$/, '@2x.webp');
const otherLang = article.lang !== lang;
const downloadName = article.file.split('/').pop();
const thumbAlt = fr ? `Première page de l’article « ${article.title} »` : `First page of the article “${article.title}”`;
const Thumb = hasFile ? 'a' : 'div';
const page = publicationPath(article.id, lang);
const date = formatPubDate(article.date, lang);
const meta = [
  article.readingTime ? (fr ? `${article.readingTime} min de lecture` : `${article.readingTime}-minute read`) : article.pages ? `${article.pages} pages` : '',
  otherLang ? (article.lang === 'fr' ? 'In French' : 'En anglais') : '',
].filter(Boolean);
---
<article class="grid grid-cols-[6.5rem_1fr] gap-5 sm:grid-cols-[9rem_1fr] sm:gap-7">
  <Thumb
    {...(hasFile ? { href: article.file, download: downloadName, 'aria-label': fr ? `Télécharger « ${article.title} » (PDF)` : `Download “${article.title}” (PDF)` } : {})}
    class:list={['group relative block self-start border border-bordure bg-white shadow-[5px_5px_0_var(--color-bordure)]', hasFile && 'transition-transform hover:-translate-y-0.5']}
  >
    {hasThumb ? (
      <img
        src={article.thumb}
        srcset={publicFileExists(thumb2x) ? `${article.thumb} 1x, ${thumb2x} 2x` : undefined}
        alt={thumbAlt}
        width="340"
        height="481"
        class="block aspect-[1/1.414] w-full object-cover object-top"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <DocCover title={article.title} tone={tone} kicker={article.series ? article.series[lang] : 'Phi-Lean Press'} />
    )}
    {hasFile && (
      <span class="absolute right-1.5 bottom-1.5 grid h-8 w-8 place-items-center bg-bleu text-white opacity-90 group-hover:opacity-100" aria-hidden="true">
        <Icon name="download" size={16} />
      </span>
    )}
  </Thumb>

  <div class="flex flex-col">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      {date && (
        <span class="inline-flex items-center gap-1.5 font-bold text-anthracite">
          <Icon name="calendar" size={16} class="text-bleu" />
          <time datetime={article.date}>{date}</time>
        </span>
      )}
      {meta.map((m) => <span class="text-gris">· {m}</span>)}
    </p>
    {(article.series || article.publication) && (
      <p class="mt-2 flex flex-wrap gap-2 text-xs">
        {article.series && <span class="bg-ciel px-2.5 py-1 font-bold text-bleu">{article.series[lang]}</span>}
        {article.publication && <span class="border border-bordure px-2.5 py-0.5 text-gris" lang={otherLang ? article.lang : undefined}>{article.publication}</span>}
      </p>
    )}
    <h3 class="mt-2 text-xl font-bold text-anthracite" lang={otherLang ? article.lang : undefined}>
      <a href={page} class="hover:text-bleu hover:underline">{article.title}</a>
    </h3>
    {article.subtitle && <p class="mt-1 text-[0.97rem] font-bold text-gris" lang={otherLang ? article.lang : undefined}>{article.subtitle}</p>}
    {article.hook && <p class="mt-3 max-w-[62ch] text-[0.97rem] text-anthracite/90">{article.hook[lang]}</p>}
    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-4">
      {hasFile ? (
        <a href={article.file} download={downloadName} class="inline-flex items-center gap-1.5 font-bold text-bleu hover:underline">
          <Icon name="download" size={18} />
          {fr ? 'Télécharger le PDF' : 'Download the PDF'}
          {article.pages && <span class="font-normal text-gris">({article.pages} pages)</span>}
        </a>
      ) : (
        <p class="text-sm font-bold text-gris">{fr ? 'Bientôt en téléchargement' : 'Download coming soon'}</p>
      )}
      <a href={page} class="text-[0.95rem] font-bold text-bleu hover:underline">{fr ? 'Présentation et extrait' : 'Overview and excerpt'}</a>
    </div>
  </div>
</article>
