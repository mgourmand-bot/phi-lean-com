---
/** Tuile chiffre clé (charte) : fond teinté, bande supérieure épaisse, grand chiffre. */
import type { KpiTone } from '@/data/proof';

interface Props {
  value: string;
  label: string;
  tone?: KpiTone;
  class?: string;
}
const { value, label, tone = 'blue', class: className = '' } = Astro.props;
---
<div class:list={['kpi-tile', `kpi-${tone}`, className]}>
  <p class="kpi-value">{value}</p>
  <p class="text-[0.95rem] leading-snug text-anthracite/85">{label}</p>
</div>
