---
/**
 * Formulaire de contact qualifié (envoyé par e-mail via FormSubmit).
 * Pré-remplissage possible par l'URL : /contact/?sujet=vsm-express&detail=...
 */
import FormShell from './FormShell.astro';
import type { Lang } from '@/i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';

const topics = [
  { value: 'vsm-express', label: fr ? 'Diagnostic VSM Express' : 'VSM Express Diagnostic' },
  { value: 'lean-flux-usine', label: fr ? 'Conseil : Lean Flux Usine' : 'Consulting: Lean Plant Flow' },
  { value: 'lean-flux-supply-chain', label: fr ? 'Conseil : Lean Flux Supply Chain et gestion des risques' : 'Consulting: Lean Supply Chain Flow and risk management' },
  { value: 'factbird', label: fr ? 'Factbird : TRS et énergie' : 'Factbird: OEE and energy' },
  { value: 'formation', label: fr ? 'Formation' : 'Training' },
  { value: 'serious-game', label: fr ? 'Serious Game (animation, kit ou Print & Play)' : 'Serious Game (session, kit or Print & Play)' },
  { value: 'publication', label: fr ? 'Phi-Lean Press, conférence, presse' : 'Phi-Lean Press, speaking, media' },
  { value: 'autre', label: fr ? 'Autre demande' : 'Other request' },
];
const sizes = fr
  ? ['Moins de 50 salariés', '50 à 249 salariés', '250 à 999 salariés', '1 000 salariés et plus']
  : ['Fewer than 50 employees', '50 to 249 employees', '250 to 999 employees', '1,000 employees or more'];
const horizons = fr
  ? ['Dès que possible', 'Dans les 3 mois', 'Dans les 6 mois', 'Je me renseigne']
  : ['As soon as possible', 'Within 3 months', 'Within 6 months', 'Just exploring'];
const L = {
  firstName: fr ? 'Prénom' : 'First name',
  lastName: fr ? 'Nom' : 'Last name',
  email: fr ? 'E-mail professionnel' : 'Work e-mail',
  phone: fr ? 'Téléphone' : 'Phone',
  optional: fr ? '(facultatif)' : '(optional)',
  company: fr ? 'Entreprise' : 'Company',
  role: fr ? 'Fonction' : 'Job title',
  size: fr ? 'Taille de l’entreprise' : 'Company size',
  topic: fr ? 'Votre besoin' : 'What you need',
  horizon: fr ? 'Échéance' : 'Timeline',
  message: fr ? 'Votre situation en quelques lignes' : 'Your situation in a few lines',
  messageHint: fr
    ? 'Le flux concerné, ce qui coince aujourd’hui, ce que vous avez déjà essayé.'
    : 'The flow concerned, what is stuck today, what you have already tried.',
  choose: fr ? 'Choisir…' : 'Choose…',
  submit: fr ? 'Envoyer ma demande' : 'Send my request',
};
---
<FormShell id="contact-form" lang={lang} subject={fr ? 'Nouvelle demande – phi-lean.com' : 'New enquiry – phi-lean.com (EN)'} submitLabel={L.submit}>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-firstname" class="field-label">{L.firstName} *</label>
      <input id="cf-firstname" name="Prénom" type="text" autocomplete="given-name" required class="field" />
    </div>
    <div>
      <label for="cf-lastname" class="field-label">{L.lastName} *</label>
      <input id="cf-lastname" name="Nom" type="text" autocomplete="family-name" required class="field" />
    </div>
    <div>
      <label for="cf-email" class="field-label">{L.email} *</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required class="field" />
    </div>
    <div>
      <label for="cf-phone" class="field-label">{L.phone} <span class="field-hint">{L.optional}</span></label>
      <input id="cf-phone" name="Téléphone" type="tel" autocomplete="tel" class="field" />
    </div>
    <div>
      <label for="cf-company" class="field-label">{L.company} *</label>
      <input id="cf-company" name="Entreprise" type="text" autocomplete="organization" required class="field" />
    </div>
    <div>
      <label for="cf-role" class="field-label">{L.role} *</label>
      <input id="cf-role" name="Fonction" type="text" autocomplete="organization-title" required class="field" />
    </div>
    <div>
      <label for="cf-size" class="field-label">{L.size} *</label>
      <select id="cf-size" name="Taille" required class="field">
        <option value="">{L.choose}</option>
        {sizes.map((s) => <option>{s}</option>)}
      </select>
    </div>
    <div>
      <label for="cf-horizon" class="field-label">{L.horizon} *</label>
      <select id="cf-horizon" name="Échéance" required class="field">
        <option value="">{L.choose}</option>
        {horizons.map((h) => <option>{h}</option>)}
      </select>
    </div>
  </div>
  <div>
    <label for="cf-topic" class="field-label">{L.topic} *</label>
    <select id="cf-topic" name="Besoin" required class="field">
      <option value="">{L.choose}</option>
      {topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
    </select>
  </div>
  <div>
    <label for="cf-message" class="field-label">{L.message} *</label>
    <p id="cf-message-hint" class="mb-2 text-sm text-gris">{L.messageHint}</p>
    <textarea id="cf-message" name="Message" rows="6" required aria-describedby="cf-message-hint" class="field"></textarea>
  </div>
</FormShell>

<script>
  // Pré-remplissage depuis les boutons du site (?sujet=...&detail=...)
  const params = new URLSearchParams(window.location.search);
  const topic = params.get('sujet');
  const detail = params.get('detail');
  const select = document.querySelector<HTMLSelectElement>('#cf-topic');
  const message = document.querySelector<HTMLTextAreaElement>('#cf-message');
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
  if (detail && message && !message.value) message.value = `${detail}\n\n`;
</script>
