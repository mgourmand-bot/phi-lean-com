---
/**
 * Enveloppe commune des formulaires : chaque envoi arrive par e-mail à
 * site.forms.recipient, via FormSubmit (par défaut) ou Web3Forms
 * (PUBLIC_FORM_PROVIDER=web3forms + PUBLIC_WEB3FORMS_KEY). Voir README.
 *
 * mode="ajax" : envoi en arrière-plan, confirmation affichée sur place.
 *               Sans JavaScript, repli automatique en envoi classique.
 * mode="post" : envoi classique (obligatoire pour les pièces jointes, ex. CV),
 *               puis retour sur la page de remerciement.
 * Anti-spam : champ piège (« _honey » ou « botcheck ») ; captcha FormSubmit en mode « post ».
 * En cas de refus du service (ex. formulaire pas encore activé), sa réponse
 * s'affiche en petit sous le message d'erreur, pour diagnostiquer.
 */
import { site, formEndpoints } from '@/config/site';
import { routes, type Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';

interface Props {
  id: string;
  lang: Lang;
  subject: string;
  mode?: 'ajax' | 'post';
  submitLabel?: string;
  successMessage?: string;
  class?: string;
}
const { id, lang, subject, mode = 'ajax', submitLabel, successMessage, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const thanksUrl = new URL(routes.thanks[lang], site.url).href;
const web3 = site.forms.provider === 'web3forms';
---
<form
  id={id}
  action={formEndpoints.post}
  method="POST"
  enctype={mode === 'post' ? 'multipart/form-data' : undefined}
  data-form-mode={mode}
  data-ajax-endpoint={formEndpoints.ajax}
  data-msg-sending={t('form.sending')}
  data-msg-success={successMessage ?? t('form.success')}
  data-msg-error={`${t('form.error')} ${site.email}.`}
  class:list={['space-y-5', className]}
>
  {web3 ? (
    <>
      <input type="hidden" name="access_key" value={site.forms.web3formsKey} />
      <input type="hidden" name="subject" value={subject} />
      <input type="hidden" name="from_name" value="Site phi-lean.com" />
      <input type="hidden" name="redirect" value={thanksUrl} />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />
    </>
  ) : (
    <>
      <input type="hidden" name="_subject" value={subject} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value={thanksUrl} />
      <input type="hidden" name="_captcha" value={mode === 'ajax' ? 'false' : 'true'} />
    </>
  )}
  <input type="hidden" name="Langue" value={lang.toUpperCase()} />
  <input type="hidden" name="Page" value="" data-page-url />
  {!web3 && (
    <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
      <label>Ne pas remplir <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
    </div>
  )}

  <slot />

  <div class="flex items-start gap-3">
    <input id={`${id}-consent`} name="Consentement" type="checkbox" value="oui" required class="mt-1 h-5 w-5 shrink-0 accent-bleu" />
    <label for={`${id}-consent`} class="text-sm text-anthracite/85">
      {t('form.consent')}{' '}
      <a href={routes.privacy[lang]} class="font-bold text-bleu underline underline-offset-2">{t('form.privacyLink')}</a>
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary" data-submit>{submitLabel ?? t('form.send')}</button>
    <p class="text-sm text-gris">* {t('form.required')}</p>
  </div>
  <div data-form-status role="status" aria-live="polite" class="hidden px-4 py-3 text-[0.95rem] font-bold"></div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-form-mode]').forEach((form) => {
    const pageField = form.querySelector<HTMLInputElement>('[data-page-url]');
    if (pageField) pageField.value = window.location.href;
    if (form.dataset.formMode !== 'ajax') return;

    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const show = (ok: boolean, text: string, detail = '') => {
      status.textContent = text;
      if (detail) {
        const small = document.createElement('span');
        small.className = 'mt-1 block text-xs font-normal';
        small.textContent = detail;
        status.append(small);
      }
      status.className = 'px-4 py-3 text-[0.95rem] font-bold ' + (ok ? 'bg-menthe text-turquoise-fonce' : 'bg-corail-pale text-[#9a3412]');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // Les champs multiples (cases à cocher) sont regroupés en une seule ligne
      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        if (typeof value !== 'string') return;
        payload[key] = payload[key] ? `${payload[key]}, ${value}` : value;
      });
      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = form.dataset.msgSending ?? '…';
      try {
        const response = await fetch(form.dataset.ajaxEndpoint ?? '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await response.json().catch(() => ({}))) as { success?: unknown; message?: unknown };
        // FormSubmit répond « "true" » (texte), Web3Forms « true » : on compare en texte.
        const ok = response.ok && String(data.success) === 'true';
        if (!ok) throw new Error(typeof data.message === 'string' && data.message ? data.message : `HTTP ${response.status}`);
        form.reset();
        if (pageField) pageField.value = window.location.href;
        show(true, form.dataset.msgSuccess ?? '');
      } catch (error) {
        const detail = error instanceof Error && error.message !== 'Failed to fetch' ? error.message : 'network';
        console.warn('[Phi-Lean] formulaire non envoyé :', detail);
        show(false, form.dataset.msgError ?? '', `(${detail})`);
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  });
</script>
