---
/** Bandeau d'appel à l'action de fin de page (fond bleu). */
import Icon from '../ui/Icon.astro';
import type { Lang } from '@/i18n/routes';
import { path, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const fr = Astro.props.lang === 'fr';
const {
  lang,
  title = fr ? 'Parlons de votre flux' : "Let's talk about your flow",
  text = fr
    ? "Trente minutes au téléphone suffisent souvent pour savoir si un diagnostic est utile, et sur quel périmètre. L'échange est sans engagement."
    : 'Thirty minutes on the phone is often enough to know whether a diagnostic makes sense, and on which scope. No commitment.',
} = Astro.props;
const t = useTranslations(lang);
---
<section class="on-dark bg-bleu text-white">
  <div class="container-pl grid gap-8 py-16 md:py-20 lg:grid-cols-[1.4fr_1fr] lg:items-center">
    <div>
      <h2 class="text-3xl font-bold tracking-tight md:text-[2.5rem]">{title}</h2>
      <p class="mt-4 max-w-[56ch] text-lg text-white/85">{text}</p>
    </div>
    <div class="flex flex-wrap gap-4 lg:justify-end">
      <a href={path('contact', lang, '#rdv')} class="btn btn-light">
        <Icon name="calendar" size={18} />
        {t('cta.meeting')}
      </a>
      <a href={path('contact', lang, '#formulaire')} class="btn btn-ghost-light">{t('cta.contact')}</a>
    </div>
  </div>
</section>
