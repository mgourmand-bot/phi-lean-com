---
/**
 * PAGE PHI-LEAN PRESS (FR et EN « /publications/ »)
 * #livres   : couverture agrandissable + résumé d'accroche
 * #articles : première page (clic = téléchargement direct) + résumé d'accroche
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import BookCard from '@/components/press/BookCard.astro';
import ArticleCard from '@/components/press/ArticleCard.astro';
import Lightbox from '@/components/Lightbox.astro';
import { books, articlesFor } from '@/data/publications';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/routes';
import { anchorId } from '@/i18n/utils';
import { publicFileExists } from '@/lib/files';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';

const c = {
  fr: {
    title: 'Phi-Lean Press : livres et articles sur le Lean et la supply chain',
    description:
      'Les publications de Manuel Gourmand : « Prendre le virage de l’IA », guide pour dirigeants de TPE et PME (Amazon, 15 novembre 2026), un e-book gratuit et des articles en téléchargement libre.',
    crumb: 'Phi-Lean Press',
    lead: 'Ce que nous apprenons sur le terrain, nous le publions. Des livres pour prendre du recul, des articles à télécharger librement pour nourrir la réflexion.',
    books: 'Livres',
    booksLead: 'Cliquez sur une couverture pour l’agrandir.',
    articles: 'Articles',
    articlesLead: 'En libre accès : cliquez sur la première page pour télécharger l’article, sans inscription.',
  },
  en: {
    title: 'Phi-Lean Press: books and articles on Lean and supply chain',
    description:
      'Publications by Manuel Gourmand: “Prendre le virage de l’IA”, a guide for small business leaders (Amazon, 15 November 2026), a free e-book and articles free to download.',
    crumb: 'Phi-Lean Press',
    lead: 'What we learn in the field, we publish. Books to step back, and articles free to download to feed your thinking.',
    books: 'Books',
    booksLead: 'Click a cover to enlarge it.',
    articles: 'Articles',
    articlesLead: 'Open access: click the first page to download the article, no sign-up needed.',
  },
}[lang];

const list = articlesFor(lang);
const tones = ['blue', 'turq', 'sun'] as const;

const jsonLd = [
  ...books.map((b) => ({
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: b.title,
    alternativeHeadline: b.subtitle,
    inLanguage: b.lang,
    isbn: b.isbn,
    datePublished: b.releaseDate,
    image: b.cover ? new URL(b.cover, site.url).href : undefined,
    author: { '@type': 'Person', '@id': `${site.url}/#founder`, name: site.founder.name },
    publisher: { '@type': 'Organization', name: 'Phi-Lean Press' },
    isAccessibleForFree: Boolean(b.file),
  })),
  ...list
    .filter((a) => publicFileExists(a.file))
    .map((a) => ({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: a.title,
      inLanguage: a.lang,
      author: { '@type': 'Person', name: site.founder.name },
      publisher: { '@type': 'Organization', name: 'Phi-Lean Press' },
      isAccessibleForFree: true,
      url: new URL(a.file, site.url).href,
    })),
];
---
<BaseLayout lang={lang} routeKey="publications" title={c.title} description={c.description} jsonLd={jsonLd}>
  <PageHero lang={lang} crumb={c.crumb} title="Phi-Lean Press" lead={c.lead}>
    <nav slot="actions" aria-label={fr ? 'Sur cette page' : 'On this page'} class="mt-8 flex flex-wrap gap-3">
      <a href={`#${anchorId('books', lang)}`} class="border border-bordure bg-white px-4 py-2 text-[0.95rem] font-bold text-bleu hover:border-bleu">{c.books}</a>
      <a href={`#${anchorId('articles', lang)}`} class="border border-bordure bg-white px-4 py-2 text-[0.95rem] font-bold text-bleu hover:border-bleu">{c.articles}</a>
    </nav>
  </PageHero>

  <section id={anchorId('books', lang)} class="py-16 md:py-24" aria-labelledby="h-livres">
    <div class="container-pl">
      <h2 id="h-livres" class="section-title">{c.books}</h2>
      <p class="mt-5 text-gris">{c.booksLead}</p>
      <div class="mt-12 space-y-14">
        {books.map((book, i) => (
          <div class:list={[i > 0 && 'border-t border-bordure pt-14']}>
            <BookCard book={book} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id={anchorId('articles', lang)} class="border-t border-bordure bg-zebra py-16 md:py-24" aria-labelledby="h-articles">
    <div class="container-pl">
      <h2 id="h-articles" class="section-title">{c.articles}</h2>
      <p class="mt-5 text-gris">{c.articlesLead}</p>
      <div class="mt-12 grid gap-x-12 gap-y-12 lg:grid-cols-2">
        {list.map((article, i) => (
          <div class="border-b border-bordure pb-12 lg:[&:nth-last-child(-n+2)]:border-0 lg:[&:nth-last-child(-n+2)]:pb-0">
            <ArticleCard article={article} lang={lang} tone={tones[i % 3]} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    lang={lang}
    title={fr ? 'Une conférence, une intervention, une interview ?' : 'A talk, a lecture, an interview?'}
    text={fr
      ? 'Manuel Gourmand intervient en entreprise, en école et en conférence, en français, en anglais et en portugais.'
      : 'Manuel Gourmand speaks at companies, schools and conferences, in French, English and Portuguese.'}
  />
  <Lightbox lang={lang} />
</BaseLayout>
