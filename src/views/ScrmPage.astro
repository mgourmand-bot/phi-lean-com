const sources = [
  { t: 'McKinsey Global Institute (2020). COVID-19 and climate change expose dangers of unstable supply chains.', u: 'https://www.mckinsey.com/capabilities/operations/our-insights/covid-19-and-climate-change-expose-dangers-of-unstable-supply-chains' },
  { t: 'Allianz Commercial (2026). Allianz Risk Barometer 2026: Business interruption.', u: 'https://commercial.allianz.com/news-and-insights/expert-risk-articles/allianz-risk-barometer-2026-business-interruption.html' },
  { t: 'Simchi-Levi, D., Schmidt, W., & Wei, Y. (2014). From superstorms to factory fires. Harvard Business Review, 92(1–2), 96–101.', u: 'https://dsl.mit.edu/biblio/superstorms-factory-fires-managing-unpredictable-supply-chain-disruptions' },
  { t: 'Elsayed, M., Grosse Steffen, C., & Marx, M. (2026). Global supply chain tensions: Not all disruptions are alike. Banque de France.', u: 'https://www.banque-france.fr/en/publications-and-statistics/publications/global-supply-chain-tensions-not-all-disruptions-are-alike' },
