  { t: 'Bibby Financial Services (2026). 70% of UK importers and exporters fear bankruptcy as Iran war hampers supply chains.', u: 'https://www.bibbyfinancialservices.com/news/70-percent-of-uk-importers-and-exporters-fear-bankruptcy-as-iran-war-hampers-supply-chains-and-drives-costs-higher' },
  { t: 'BBC News (2025). Suppliers’ uncertainty despite JLR expected restart (AOL republication).', u: 'https://www.aol.com/articles/suppliers-uncertainty-despite-jlr-expected-063005447.html' },
  { t: 'Clubic (2025). Une entreprise de logiciels basée en France terrassée par une cyberattaque.', u: 'https://www.clubic.com/actualite-558105-une-entreprise-de-logiciels-basee-en-france-terrassee-par-une-cyberattaque-et-elle-va-disparaitre.html' },
  { t: 'Thun, J.-H., Drüke, M., & Hoenig, D. (2011). Managing uncertainty: An empirical analysis of supply chain risk management in SMEs. International Journal of Production Research, 49(18), 5511–5525.', u: 'https://www.econbiz.de/Record/managing-uncertainty-an-empirical-analysis-of-supply-chain-risk-management-in-small-and-medium-sized-enterprises/10009298524' },
