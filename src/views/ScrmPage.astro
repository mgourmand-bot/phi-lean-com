const maxDays = Math.max(...c.exRows.flatMap((r) => [r.tts, r.ttr]));
const smeHref = anchorPath('contact', 'form', lang, '?sujet=scrm-pme');
const largeHref = anchorPath('contact', 'form', lang, '?sujet=scrm-grands-comptes');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Lean Supply Chain Risk Management',
  description: c.description,
  serviceType: 'Supply Chain Risk Management',
  provider: { '@id': `${site.url}/#organization` },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: c.offersTitle,
    itemListElement: [c.smeTitle, ...c.offers.map((o) => o.t)].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
};
---
<BaseLayout lang={lang} routeKey="scrm" title={c.title} description={c.description} jsonLd={jsonLd}>
  <PageHero lang={lang} crumb={c.crumb} parents={[{ label: c.parent, href: routes.consulting[lang] }]} title={c.h1} lead={c.lead} size="lg">
    <div slot="before" class="mb-5"><span class="inline-flex border-2 border-bleu bg-white px-3.5 py-1.5 text-[0.95rem] font-bold text-bleu">Lean Supply Chain Risk Management</span></div>
    <div slot="aside">
      <p class="mb-3 text-xs font-bold tracking-[0.14em] text-gris uppercase">{c.choose}</p>
      <div class="grid gap-4">
        <a href={`#${sme}`} class="group block border border-bordure border-l-[6px] border-l-turquoise bg-white p-5 transition-colors hover:border-turquoise">
          <span class="block text-xl font-bold text-turquoise-fonce group-hover:underline">{c.smeChoice} →</span>
          <span class="mt-1 block text-[0.95rem] text-anthracite/85">{c.smeChoiceText}</span>
        </a>
        <a href={`#${large}`} class="group block border border-bordure border-l-[6px] border-l-bleu bg-white p-5 transition-colors hover:border-bleu">
          <span class="block text-xl font-bold text-bleu group-hover:underline">{c.largeChoice} →</span>
          <span class="mt-1 block text-[0.95rem] text-anthracite/85">{c.largeChoiceText}</span>
        </a>
      </div>
    </div>
  </PageHero>

  <!-- CHIFFRES ET CONTEXTE -->
  <section class="py-16 md:py-20" aria-labelledby="h-figures">
    <div class="container-pl">
      <h2 id="h-figures" class="section-title">{c.figuresTitle}</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {c.figures.map((f, i) => (
          <li class:list={['kpi-tile p-5', i < 2 ? 'kpi-sun' : 'kpi-coral']}>
            <p class="kpi-value text-3xl font-bold whitespace-nowrap">{f.v}</p>
            <p class="mt-2 text-[0.95rem] leading-snug">{f.l}</p>
            <p class="mt-2 text-xs text-gris">{f.s}</p>
          </li>
        ))}
      </ul>

      <h3 class="mt-16 text-2xl font-bold text-anthracite">{c.whyTitle}</h3>
      <ol class="mt-6 border-l-2 border-bordure">
        {c.why.map((w) => (
          <li class="relative grid gap-1 pb-5 pl-6 last:pb-0 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <span class="absolute top-1.5 -left-[7px] h-3 w-3 bg-corail" aria-hidden="true"></span>
            <span class="font-bold text-corail">{w.d}</span>
            <span class="text-anthracite/90">{w.t}</span>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-[70ch] text-lg font-bold text-anthracite">{c.whyNote}</p>
    </div>
  </section>

  <!-- MÉTHODE TTS / TTR -->
  <section class="border-y border-bordure bg-zebra py-16 md:py-20" aria-labelledby="h-method">
    <div class="container-pl grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-start">
      <div>
        <h2 id="h-method" class="section-title">{c.methodTitle}</h2>
        <div class="mt-6 max-w-[62ch] space-y-4 text-[1.05rem] leading-relaxed">{c.methodText.map((p) => <p>{p}</p>)}</div>
      </div>
      <figure class="m-0 border border-bordure bg-white p-6 md:p-7">
        <figcaption class="text-xs font-bold tracking-[0.14em] text-gris uppercase">{c.exTitle}</figcaption>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          <li class="flex items-center gap-2"><span class="h-3 w-5 bg-turquoise" aria-hidden="true"></span>{c.exTts}</li>
          <li class="flex items-center gap-2"><span class="h-3 w-5 bg-corail" aria-hidden="true"></span>{c.exTtr}</li>
        </ul>
        <div class="mt-5 space-y-6">
          {c.exRows.map((r) => {
            const gap = r.ttr - r.tts;
            return (
              <div>
                <p class="flex flex-wrap items-baseline justify-between gap-2">
                  <span class="font-bold text-anthracite">{r.item}</span>
                  <span class:list={['text-sm font-bold', gap > 0 ? 'text-corail' : 'text-turquoise-fonce']}>
                    {gap > 0 ? `${c.exGap} : ${gap} ${c.exDays}` : c.exCovered}
                  </span>
                </p>
                <div class="mt-2 space-y-1.5" aria-hidden="true">
                  <div class="flex items-center gap-2"><span class="block h-3 bg-turquoise" style={`width:${(r.tts / maxDays) * 85}%`}></span><span class="text-xs text-gris">{r.tts}</span></div>
                  <div class="flex items-center gap-2"><span class="block h-3 bg-corail" style={`width:${(r.ttr / maxDays) * 85}%`}></span><span class="text-xs text-gris">{r.ttr}</span></div>
                </div>
                <p class="sr-only">{c.exTts} : {r.tts} {c.exDays}. {c.exTtr} : {r.ttr} {c.exDays}.</p>
              </div>
            );
          })}
        </div>
        <p class="mt-6 border-t border-bordure pt-4 text-[0.95rem] text-anthracite/90">{c.exMoney}</p>
      </figure>
    </div>
  </section>

  <!-- LEAN ET RÉSILIENCE -->
  <section class="py-16 md:py-20" aria-labelledby="h-lean">
    <div class="container-pl grid gap-12 lg:grid-cols-2">
      <div>
        <h2 id="h-lean" class="section-title">{c.leanTitle}</h2>
        <p class="mt-6 max-w-[62ch] text-[1.05rem] leading-relaxed">{c.leanText}</p>
        <a href={housePath('resultat', lang)} class="link-pl mt-5 inline-block">{c.houseLink}</a>
      </div>
      <dl class="divide-y divide-bordure border-y border-bordure self-start">
        {c.leanList.map((l) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-4">
            <dt class="font-bold text-bleu">{l.k}</dt>
            <dd class="text-anthracite/85">{l.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- PME -->
  <section id={sme} class="scroll-mt-24 border-y border-bordure bg-menthe/60 py-16 md:py-24" aria-labelledby="h-sme">
    <div class="container-pl">
      <p class="text-xs font-bold tracking-[0.14em] text-turquoise-fonce uppercase">{c.smeKicker}</p>
      <h2 id="h-sme" class="mt-2 text-3xl font-bold tracking-tight text-turquoise-fonce md:text-4xl">{c.smeTitle}</h2>
      <p class="lead mt-5">{c.smeLead}</p>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {c.smeFacts.map((f) => <li class="border-l-4 border-corail bg-white p-5 text-[0.97rem]">{f}</li>)}
      </ul>
      <div class="mt-12 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
        <ol class="space-y-5">
          {c.smeDays.map((d) => (
            <li class="grid grid-cols-[5.5rem_1fr] gap-5 border border-bordure bg-white p-5">
              <div>
                <p class="text-sm font-bold text-gris">{d.d}</p>
                <p class="text-2xl font-bold text-turquoise-fonce">{d.t}</p>
              </div>
              <p class="text-anthracite/90">{d.x}</p>
            </li>
          ))}
        </ol>
        <div class="callout callout-turq self-start">
          <p class="callout-head">{fr ? 'Ce que vous obtenez' : 'What you get'}</p>
          <div class="callout-body">
            <ul class="list-square">{c.smeDeliverables.map((d) => <li>{d}</li>)}</ul>
            <p class="mt-4 text-sm text-gris">{c.smeFor}</p>
            <a href={smeHref} class="btn btn-primary mt-5">{c.smeCta}</a>
          </div>
        </div>
      </div>
      <a href={publicationPath('combien-de-jours-tenez-vous', lang)} class="mt-10 inline-flex items-center gap-2 font-bold text-bleu hover:underline">
        <Icon name="book" size={18} /> {c.smeBook}
      </a>
    </div>
  </section>

  <!-- GRANDS COMPTES -->
  <section id={large} class="scroll-mt-24 py-16 md:py-24" aria-labelledby="h-large">
    <div class="container-pl">
      <p class="text-xs font-bold tracking-[0.14em] text-bleu uppercase">{c.largeKicker}</p>
      <h2 id="h-large" class="mt-2 text-3xl font-bold tracking-tight text-bleu md:text-4xl">{c.largeTitle}</h2>
      <p class="lead mt-5">{c.largeLead}</p>
      <ol class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
        {c.practices.map((p, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4">
            <span class="grid h-10 w-10 place-items-center bg-bleu text-lg font-bold text-white" aria-hidden="true">{i + 1}</span>
            <div>
              <p class="text-lg font-bold text-anthracite">{p.t}</p>
              <p class="mt-1 text-[0.97rem] text-anthracite/85">{p.x}</p>
            </div>
          </li>
        ))}
      </ol>

      <h3 class="mt-16 text-2xl font-bold text-anthracite">{c.offersTitle}</h3>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        {c.offers.map((o) => (
          <div class="flex flex-col border border-bordure border-t-[6px] border-t-bleu bg-white p-6">
            <p class="text-lg font-bold text-bleu">{o.t}</p>
            <p class="mt-2 text-anthracite/85">{o.x}</p>
            <p class="mt-auto pt-4 text-[0.95rem]"><span class="font-bold">{c.deliverableLabel} :</span> {o.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
        <div class="callout callout-blue">
          <p class="callout-head">{c.consultantTitle}</p>
          <div class="callout-body">
            <p>{c.consultantText}</p>
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={largeHref} class="btn btn-primary">{c.largeCta}</a>
            </div>
          </div>
        </div>
        <div class="border-l-4 border-soleil bg-creme p-6">
          <p class="font-bold text-soleil-fonce">{c.expTitle}</p>
          <p class="mt-2">{c.expText}</p>
        </div>
      </div>
      <a href={publicationPath('state-of-the-art-supply-chain-risk-management-2026', lang)} class="mt-10 inline-flex items-center gap-2 font-bold text-bleu hover:underline">
        <Icon name="download" size={18} /> {c.largePaper}
      </a>
    </div>
  </section>

  <!-- FOMO SOBRE + PARTENAIRES + SOURCES -->
  <section class="border-t border-bordure bg-zebra py-16 md:py-20">
    <div class="container-pl">
      <div class="border-t-[6px] border-soleil bg-creme p-7 md:p-9">
        <h2 class="text-2xl font-bold text-anthracite">{c.fomoTitle}</h2>
        <p class="mt-3 max-w-[70ch] text-lg">{c.fomoText}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={`#${sme}`} class="btn btn-primary">{c.smeChoice}</a>
          <a href={`#${large}`} class="btn btn-secondary">{c.largeChoice}</a>
        </div>
      </div>
      <p class="mt-8 flex max-w-[80ch] items-start gap-2 text-[0.97rem]">
        <Icon name="bolt" size={18} class="mt-0.5 text-soleil" />
        <span>{c.partnersText} <a href={anchorPath('partners', 'factbird', lang)} class="link-pl">Factbird</a></span>
      </p>
      <h2 class="mt-14 text-xl font-bold text-anthracite">{c.sourcesTitle}</h2>
      <ul class="mt-4 space-y-2 text-[0.93rem]" lang="en">
        {sources.map((s) => (
          <li>
            <a href={s.u} target="_blank" rel="noopener" class="text-bleu hover:underline">{s.t}<span class="sr-only" lang={lang}> {newTab}</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
