---
/**
 * PAGE D'ACCUEIL (FR « / » et EN « /en/ ») – version executive
 * 1. La maison Phi-Lean : la thèse, puis la lecture étage par étage
 *    (la maison reste visible et surligne l'étage lu), puis les sources
 *    de chaque élément (planche « Références bibliographiques »)
 * 2. Ce que nous faisons, rattaché aux étages de la maison, et le point d'entrée
 * 3. Le fondateur
 * 4. Nos travaux (Phi-Lean Press)
 * 5. Un appel sobre à échanger
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import MaisonPhiLean from '@/components/MaisonPhiLean.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import { house, floors, sources, elementChip, type ElementId, type RefSegment, type FloorId } from '@/data/house';
import { housePath, houseBase, publicationPath } from '@/i18n/slugs';
import { getPublication, formatPubDate } from '@/data/publications';
import { caseStudies } from '@/data/cases';
import { vsmExpress } from '@/data/offers';
import { site } from '@/config/site';
import { founderHeadline, founderShortBio, founderProof, founderLinks } from '@/data/founder';
import type { Lang } from '@/i18n/routes';
import { path, anchorPath, formatPrice } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const price = formatPrice(vsmExpress.priceHT, lang);

const c = {
  fr: {
    title: 'Phi-Lean – Excellence opérationnelle : profitables aujourd’hui et demain',
    description:
      'Phi-Lean accompagne les dirigeants qui veulent une entreprise profitable aujourd’hui et demain : Lean Flux Usine, Lean Flux Supply Chain et gestion des risques, formation des équipes. Fondé par Manuel Gourmand.',
    h1: 'Profitables aujourd’hui et demain.',
    subtitle: 'Une culture de l’excellence opérationnelle bâtie avec vos équipes.',
    lead: 'Réduire les coûts ne suffit pas : vos revenus doivent croître plus vite que vos dépenses. Phi-Lean vous y aide, de l’usine à la supply chain.',
    deeper: 'Approfondir',
    meet: 'Prendre rendez-vous',
    lines: 'Ce que nous faisons',
    readTitle: 'La maison, de la base au cap',
    caption: 'La maison Phi-Lean est développée dans le manifeste',
    manifesto: 'Make Europe Great Again, Economically',
    manifestoMeta: '(PDF en anglais, 8 pages)',
    sheet: 'La planche et ses sources',
    sheetMeta: '(PDF, 2 pages)',
    sourcesTitle: 'Les sources de chaque élément',
    sourcesLead: 'Chaque élément de la maison s’appuie sur des travaux de référence : sept ouvrages et articles, cités au format APA (7e édition). Cliquez sur un élément pour lire l’analyse complète et ce que nous en faisons en mission.',
    sourcesDownload: 'Télécharger la maison et ses sources',
    refsLabel: 'Sources',
    whatTitle: 'Ce que nous faisons',
    whatLead: 'Six façons d’intervenir dans la maison, toujours sur le terrain et avec vos équipes, des PME aux grands groupes.',
    entryTitle: 'Pour commencer : le Diagnostic VSM Express',
    entryText: `Trois jours sur site, un flux cartographié avec vos équipes, un plan d’action chiffré à 90 jours. Forfait de ${price} HT, déductible de la mission qui suit.`,
    entryCta: 'Voir le déroulé',
    casesTitle: 'Études de cas',
    founderCta: 'Son parcours complet',
    credentials: [
      { k: 'Formation', v: 'Ingénieur ENIM · MSc Lean Enterprise, University of Buckingham (Distinction)' },
      { k: 'Terrain', v: 'Direction de site, démarrage et intégration d’usines, supply chain groupe' },
      { k: 'Secteurs', v: 'Machines agricoles, voirie, papier, ingrédients pharmaceutiques, distribution' },
      { k: 'Langues', v: 'Français, anglais, portugais' },
    ],
    worksTitle: 'Nos travaux',
    quote: 'Le logiciel ne coûte presque rien. La discipline nécessaire pour bien le mettre en œuvre, elle, est ce qui coûte : pas en argent, mais en réflexion.',
    quoteSource: 'La spirale d’attrition systémique, 2026',
    worksAll: 'Toute la Phi-Lean Press',
    download: 'Télécharger le PDF',
    bookLink: 'Voir le livre',
    ctaTitle: 'Trente minutes pour faire le point',
    ctaText: 'Un échange avec Manuel Gourmand, en visio ou au téléphone, pour comprendre votre situation et voir ensemble si un diagnostic a du sens.',
  },
  en: {
    title: 'Phi-Lean – Operational excellence: profitable today and tomorrow',
    description:
      'Phi-Lean works with business leaders who want a company that is profitable today and tomorrow: Lean Plant Flow, Lean Supply Chain Flow and risk management, team training. Founded by Manuel Gourmand.',
    h1: 'Profitable today and tomorrow.',
    subtitle: 'A culture of operational excellence, built with your teams.',
    lead: 'Cutting costs is not enough: your income must grow faster than your expenses. Phi-Lean helps you get there, from the plant to the supply chain.',
    deeper: 'Read more',
    meet: 'Book a call',
    lines: 'What we do',
    readTitle: 'The house, from the foundation up',
    caption: 'The Phi-Lean house is developed in the manifesto',
    manifesto: 'Make Europe Great Again, Economically',
    manifestoMeta: '(PDF, 8 pages)',
    sheet: 'The house and its sources',
    sheetMeta: '(PDF in French, 2 pages)',
    sourcesTitle: 'The sources behind each element',
    sourcesLead: 'Each element of the house rests on established work: seven books and articles, cited in APA style (7th edition). Click an element for the full analysis and what we do with it in our work.',
    sourcesDownload: 'Download the house and its sources',
    refsLabel: 'Sources',
    whatTitle: 'What we do',
    whatLead: 'Six ways to work on the house, always on the ground and with your teams, from SMEs to large groups.',
    entryTitle: 'To get started: the VSM Express Diagnostic',
    entryText: `Three days on site, one value stream mapped with your teams, a costed 90-day action plan. Fixed fee of ${price} excl. VAT, deductible from the engagement that follows.`,
    entryCta: 'See how it works',
    casesTitle: 'Case studies',
    founderCta: 'His full career',
    credentials: [
      { k: 'Education', v: 'ENIM engineer · MSc Lean Enterprise, University of Buckingham (Distinction)' },
      { k: 'Field', v: 'Site management, plant start-up and integration, group supply chain' },
      { k: 'Sectors', v: 'Agricultural machinery, municipal vehicles, paper, pharmaceutical ingredients, distribution' },
      { k: 'Languages', v: 'French, English, Portuguese' },
    ],
    worksTitle: 'Our writing',
    quote: 'The software costs almost nothing. The discipline to implement it well is what costs: not in money, but in thinking.',
    quoteSource: 'The Systemic Attrition Spiral, 2026',
    worksAll: 'All of Phi-Lean Press',
    download: 'Download the PDF',
    bookLink: 'See the book',
    ctaTitle: 'Thirty minutes to take stock',
    ctaText: 'A conversation with Manuel Gourmand, by video or phone, to understand your situation and see together whether a diagnostic makes sense.',
  },
}[lang];

const floorColor: Record<string, string> = {
  socle: 'text-bleu',
  leviers: 'text-bleu',
  methode: 'text-bleu',
  resultat: 'text-bleu',
  cap: 'text-soleil-fonce',
};

/** Pastilles des sources : chacune mène à la page de son élément. */
const chip = elementChip;
/** Étage → élément(s) de la maison qui ont une page. */
const floorElements: Record<FloorId, ElementId[]> = {
  socle: ['socle'],
  leviers: ['capacite', 'valeur'],
  methode: ['methode'],
  resultat: ['resultat'],
  cap: ['cap'],
};
const elementName = (id: ElementId) => sources.find((g) => g.id === id)!.element[lang];
// Les références sont en anglais (lang="en") ; seul un segment traduit suit la langue de la page.
const seg = (x: RefSegment) =>
  typeof x === 'string' ? { text: x, kind: 'plain' } : 'i' in x ? { text: x.i, kind: 'italic' } : { text: x.t[lang], kind: 'local' };

const offers = [
  {
    floor: fr ? 'Les piliers : servir plus, servir mieux' : 'The pillars: serve more, serve better',
    title: fr ? 'Lean Flux Usine' : 'Lean Plant Flow',
    text: fr
      ? 'Le Lean appliqué à l’usine, à partir de la cartographie des flux (VSM) : libérer de la capacité sans investissement lourd, et obtenir la qualité du premier coup.'
      : 'Lean applied to the plant, starting from value stream mapping: free up capacity without heavy investment, and get quality right first time.',
    links: [{ href: anchorPath('consulting', 'usine', lang), label: fr ? 'Lean Flux Usine' : 'Lean Plant Flow' }],
  },
  {
    floor: fr ? 'Les piliers, dans les bureaux' : 'The pillars, in the office',
    title: fr ? 'Lean Flux Services' : 'Lean Services Flow',
    text: fr
      ? 'Pour les entreprises de service et les fonctions support : mesurer la demande d’échec (relances, ressaisies, réclamations), raccourcir le délai client, automatiser seulement au bon endroit.'
      : 'For service businesses and support functions: measure failure demand (chasers, re-keying, complaints), shorten customer lead time, automate only in the right place.',
    links: [{ href: path('services', lang), label: fr ? 'Lean Flux Services' : 'Lean Services Flow' }],
  },
  {
    floor: fr ? 'La poutre : le flux de bout en bout' : 'The beam: the end-to-end flow',
    title: fr ? 'Lean Flux Supply Chain' : 'Lean Supply Chain Flow',
    text: fr
      ? 'Le même regard au-delà de vos murs, des fournisseurs aux clients : flux tirés entre sites et entrepôts, stocks de sécurité dimensionnés, S&OP qui fonctionne.'
      : 'The same view beyond your walls, from suppliers to customers: pull flows between sites and warehouses, properly sized safety stock, an S&OP that works.',
    links: [{ href: anchorPath('consulting', 'supply', lang), label: fr ? 'Lean Flux Supply Chain' : 'Lean Supply Chain Flow' }],
  },
  {
    floor: fr ? 'Le toit : le « demain »' : 'The roof: the “tomorrow”',
    title: 'Lean Supply Chain Risk Management',
    text: fr
      ? 'Savoir combien de jours vous tenez si votre premier fournisseur s’arrête, et fermer les trous qui comptent. Une offre pour les PME, une pour les grands groupes.'
      : 'Know how many days you can last if your first supplier stops, and close the gaps that matter. One offer for SMEs, one for large groups.',
    links: [{ href: path('scrm', lang), label: fr ? 'Gestion des risques' : 'Risk management' }],
  },
  {
    floor: fr ? 'Le socle et le cap' : 'The foundation and the direction',
    title: fr ? 'Équipes et comités de direction' : 'Teams and leadership teams',
    text: fr
      ? 'Des formations opérationnelles et des serious games pour les équipes, et un exercice de gestion de crise conçu pour les comités de direction.'
      : 'Hands-on training and serious games for teams, and a crisis management exercise designed for leadership teams.',
    links: [
      { href: path('training', lang), label: fr ? 'Formation' : 'Training' },
      { href: `${path('games', lang)}#codir-crise`, label: fr ? 'Exercice de crise' : 'Crisis exercise' },
    ],
  },
  {
    floor: fr ? 'Quand il faut quelqu’un, maintenant' : 'When you need someone, now',
    title: fr ? 'Management de transition' : 'Interim management',
    text: fr
      ? 'Une direction de site, de supply chain, de maintenance ou des opérations à assurer pendant quelques mois : Manuel Gourmand prend le poste et laisse une organisation qui tient.'
      : 'A site, supply chain, maintenance or operations leadership role to cover for a few months: Manuel Gourmand steps in and leaves an organisation that holds.',
    links: [{ href: anchorPath('contact', 'form', lang, '?sujet=autre&detail=' + encodeURIComponent(fr ? 'Management de transition' : 'Interim management')), label: fr ? 'En parler' : 'Discuss it' }],
  },
];

// Nos travaux : quatre publications, chacune avec sa page (data : src/data/publications.ts)
const workIds = fr
  ? ['make-europe-great-again-economically', 'combien-de-jours-tenez-vous', 'spirale-attrition-systemique', 'prendre-le-virage-de-l-ia']
  : ['make-europe-great-again-economically', 'state-of-the-art-supply-chain-risk-management-2026', 'the-systemic-attrition-spiral', 'combien-de-jours-tenez-vous'];
const works = workIds.map((id) => {
  const p = getPublication(id);
  const isBook = p.kind === 'book';
  const kind = isBook ? (p.file ? (fr ? 'E-book gratuit' : 'Free e-book') : fr ? 'Livre' : 'Book') : p.kind === 'article' && p.publication ? p.publication : fr ? 'Article' : 'Paper';
  const when = isBook && p.releaseDate ? (fr ? `parution le ${formatPubDate(p.releaseDate, lang)}` : `out on ${formatPubDate(p.releaseDate, lang)}`) : formatPubDate(p.date, lang);
  const langNote = p.lang !== lang ? (p.lang === 'fr' ? 'in French' : 'en anglais') : '';
  return {
    title: p.title,
    meta: [kind, when, p.pages ? `${p.pages} pages` : '', langNote].filter(Boolean).join(' · '),
    text: p.takeaways[lang][0],
    thumb: isBook ? p.cover! : p.thumb!,
    page: publicationPath(p.id, lang),
    file: p.file,
    lang: p.lang,
  };
});
const manifestoFile = '/downloads/articles/make-europe-great-again-economically.pdf';
---
<BaseLayout lang={lang} routeKey="home" title={c.title} description={c.description}>
  <!-- 1. LA MAISON PHI-LEAN -->
  <section class="border-b border-bordure" aria-labelledby="h-home">
    <div class="container-pl grid gap-x-16 gap-y-12 pt-14 pb-10 md:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:pb-20">
      <div class="lg:pt-4">
        <p class="text-xs font-bold tracking-[0.16em] text-bleu uppercase">{house.eyebrow[lang]}</p>
        <h1 id="h-home" class="mt-4 max-w-[16ch] text-[2.5rem] leading-[1.06] font-bold tracking-tight text-bleu sm:text-[3.4rem] xl:text-[3.75rem]">
          {c.h1}
        </h1>
        <p class="mt-7 max-w-[30ch] text-xl leading-snug font-bold text-anthracite md:text-2xl">{c.subtitle}</p>
        <p class="mt-4 max-w-[54ch] text-lg leading-relaxed text-anthracite/85 md:text-xl">{c.lead}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={anchorPath('contact', 'meeting', lang)} class="btn btn-primary">
            <Icon name="calendar" size={18} />
            {c.meet}
          </a>
          <a href="#metiers" class="btn btn-secondary">{c.lines}</a>
        </div>
      </div>

      <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div class="mx-auto max-w-[36rem] lg:sticky lg:top-28">
          <MaisonPhiLean lang={lang} />
          <p class="mt-6 text-center">
            <a href={houseBase[lang]} class="link-pl text-[0.95rem]">{fr ? 'Explorer la maison, élément par élément' : 'Explore the house, part by part'}</a>
          </p>
          <p class="mt-4 text-center text-sm text-gris">
            {c.caption}{' '}
            <a href={manifestoFile} download class="font-bold text-bleu underline decoration-bordure underline-offset-4 hover:decoration-bleu" lang="en">{c.manifesto}</a>
            {' '}{c.manifestoMeta}
          </p>
          <p class="mt-1 text-center text-sm text-gris">
            <a href={house.pdf} download class="font-bold text-bleu underline decoration-bordure underline-offset-4 hover:decoration-bleu">{c.sheet}</a>
            {' '}{c.sheetMeta}
          </p>
        </div>
      </div>

      <div class="lg:col-start-1 lg:pb-28">
        <p class="text-xs font-bold tracking-[0.14em] text-gris uppercase">{c.readTitle}</p>
        <h2 class="mt-2 max-w-[30ch] text-2xl leading-snug font-bold text-anthracite">{house.title[lang]}</h2>
        <ol class="mt-6">
          {floors.map((f) => (
            <li id={`maison-${f.id}`} data-house-row={f.id} class="scroll-mt-28 border-t border-bordure py-8 lg:min-h-[17rem]">
              <p class:list={['text-xs font-bold tracking-[0.14em] uppercase', floorColor[f.id]]}>{f.label[lang]}</p>
              <h3 class="mt-2 text-2xl font-bold text-anthracite">{f.title[lang]}</h3>
              <p class="mt-3 max-w-[58ch] text-[1.05rem] leading-relaxed text-anthracite/85">{f.text[lang]}</p>
              <p class="mt-4 text-sm text-gris">
                <span class="sr-only">{c.refsLabel} : </span>
                <a href={`#source-${f.sourceId}`} class="italic underline decoration-bordure underline-offset-4 hover:text-bleu hover:decoration-bleu">{f.refs[lang]}</a>
              </p>
              <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                {floorElements[f.id].map((el) => (
                  <a href={housePath(el, lang)} class="link-pl text-[0.95rem]">
                    {c.deeper}{floorElements[f.id].length > 1 ? ` : ${elementName(el)}` : ''}
                  </a>
                ))}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 1 bis. LES SOURCES DE CHAQUE ÉLÉMENT -->
  <section id="sources" class="scroll-mt-24 border-b border-bordure bg-zebra py-14 md:py-20" aria-labelledby="h-sources">
    <div class="container-pl">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
        <div>
          <h2 id="h-sources" class="text-2xl font-bold tracking-tight text-bleu md:text-3xl">{c.sourcesTitle}</h2>
          <p class="mt-3 max-w-[64ch] text-anthracite/85">{c.sourcesLead}</p>
        </div>
        <a href={house.pdf} download class="group inline-flex items-baseline gap-1.5 font-bold text-bleu">
          <Icon name="download" size={16} class="shrink-0 self-center" />
          <span><span class="group-hover:underline">{c.sourcesDownload}</span> <span class="font-normal text-gris">{c.sheetMeta}</span></span>
        </a>
      </div>
      <ol class="mt-10 border-b border-bordure">
        {sources.map((g) => (
          <li id={`source-${g.id}`} class="grid scroll-mt-28 gap-x-10 gap-y-3 border-t border-bordure py-6 md:grid-cols-[17.5rem_minmax(0,1fr)]">
            <p class="flex flex-col items-start gap-2 self-start">
              <a
                href={housePath(g.id, lang)}
                class:list={['inline-flex items-center gap-2 px-3.5 py-1.5 text-[0.95rem] leading-tight font-bold shadow-[3px_3px_0_var(--color-bordure)] transition hover:-translate-y-0.5 hover:shadow-[4px_5px_0_var(--color-bordure)]', chip[g.id]]}
              >
                {g.element[lang]}
                <span aria-hidden="true">→</span>
              </a>
              <a href={housePath(g.id, lang)} class="text-sm font-bold text-bleu hover:underline" tabindex="-1" aria-hidden="true">{c.deeper}</a>
            </p>
            <ul class="space-y-4">
              {g.refs.map((r) => (
                <li>
                  <p class="text-[0.97rem] text-anthracite" lang="en">
                    {r.cite.map(seg).map((x) => (x.kind === 'italic' ? <i>{x.text}</i> : x.kind === 'local' ? <span lang={lang}>{x.text}</span> : x.text))}
                  </p>
                  <p class="mt-1 text-sm text-gris">{r.note[lang]}</p>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 2. CE QUE NOUS FAISONS -->
  <section id="metiers" class="scroll-mt-24 py-16 md:py-24" aria-labelledby="h-metiers">
    <div class="container-pl">
      <h2 id="h-metiers" class="section-title">{c.whatTitle}</h2>
      <p class="lead mt-6">{c.whatLead}</p>
      <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {offers.map((o) => (
          <article class="flex flex-col border-t-[3px] border-bleu pt-6">
            <p class="text-sm font-bold text-gris">{o.floor}</p>
            <h3 class="mt-2 text-2xl font-bold text-anthracite">{o.title}</h3>
            <p class="mt-3 text-anthracite/85">{o.text}</p>
            <p class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5">
              {o.links.map((l) => <a href={l.href} class="link-pl">{l.label}</a>)}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-16 flex flex-col gap-5 border-y border-bordure py-7 md:flex-row md:items-center md:justify-between md:gap-10">
        <div>
          <h3 class="text-lg font-bold text-anthracite">{c.entryTitle}</h3>
          <p class="mt-1 max-w-[72ch] text-anthracite/85">{c.entryText}</p>
        </div>
        <a href={anchorPath('consulting', 'vsmExpress', lang)} class="btn btn-secondary shrink-0">{c.entryCta}</a>
      </div>

      {caseStudies.length > 0 && (
        <>
          <h3 class="mt-16 text-2xl font-bold text-anthracite">{c.casesTitle}</h3>
          <div class="mt-6 grid gap-6 lg:grid-cols-3">
            {caseStudies.map((study) => <CaseStudyCard study={study} lang={lang} headingLevel="h4" />)}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- 3. LE FONDATEUR -->
  <section class="border-y border-bordure bg-zebra py-16 md:py-24" aria-labelledby="h-founder">
    <div class="container-pl grid gap-10 md:grid-cols-[12rem_1fr] lg:grid-cols-[15rem_minmax(0,1fr)_minmax(0,19rem)] lg:gap-14">
      <img
        src={site.founder.photo}
        alt={fr ? `${site.founder.name}, fondateur de Phi-Lean` : `${site.founder.name}, founder of Phi-Lean`}
        width="800"
        height="1000"
        class="aspect-[4/5] w-full max-w-[15rem] object-cover"
        loading="lazy"
        decoding="async"
      />
      <div>
        <h2 id="h-founder" class="text-3xl font-bold tracking-tight text-bleu">{site.founder.name}</h2>
        <p class="mt-1 font-bold text-turquoise-fonce">{founderHeadline[lang]}</p>
        <p class="mt-5 max-w-[62ch] text-lg leading-relaxed">{founderShortBio[lang]}</p>
        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={anchorPath('about', 'founder', lang)} class="link-pl">{c.founderCta}</a>
          <a href={founderLinks.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-bold text-bleu hover:underline">
            <Icon name="linkedin" size={18} /> LinkedIn<span class="sr-only">{fr ? ' (nouvel onglet)' : ' (opens in a new tab)'}</span>
          </a>
        </p>
      </div>
      <dl class="divide-y divide-bordure border-y border-bordure md:col-span-2 lg:col-span-1">
        {c.credentials.map((cr) => (
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3 text-[0.97rem]">
            <dt class="text-gris">{cr.k}</dt>
            <dd class="font-bold text-anthracite">{cr.v}</dd>
          </div>
        ))}
      </dl>
      <ul class="grid gap-4 sm:grid-cols-2 md:col-span-2 lg:col-span-3 xl:grid-cols-4">
        {founderProof.map((p) => (
          <li class:list={['kpi-tile p-5', p.tone]}>
            <p class="kpi-value text-3xl font-bold whitespace-nowrap">{p.value}</p>
            <p class="mt-2 text-[0.93rem] leading-snug text-anthracite/85">{p.label[lang]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. NOS TRAVAUX -->
  <section class="py-16 md:py-24" aria-labelledby="h-works">
    <div class="container-pl">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="h-works" class="section-title">{c.worksTitle}</h2>
        <a href={path('publications', lang)} class="link-pl">{c.worksAll}</a>
      </div>
      <blockquote class="mt-10 max-w-[48rem] border-l-4 border-soleil pl-6">
        <p class="text-xl leading-relaxed text-anthracite md:text-2xl">« {c.quote} »</p>
        <footer class="mt-3 text-sm text-gris">{site.founder.name}, <cite>{c.quoteSource}</cite></footer>
      </blockquote>
      <ul class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {works.map((w) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-5">
            <a href={w.page} class="block self-start border border-bordure bg-white" tabindex="-1" aria-hidden="true">
              <img src={w.thumb} alt="" width="340" height="481" class="block aspect-[1/1.414] w-full object-cover object-top" loading="lazy" decoding="async" />
            </a>
            <div>
              <h3 class="text-lg leading-snug font-bold text-anthracite" lang={w.lang !== lang ? w.lang : undefined}>
                <a href={w.page} class="hover:text-bleu hover:underline">{w.title}</a>
              </h3>
              <p class="mt-1 text-sm text-gris">{w.meta}</p>
              <p class="mt-2 text-[0.97rem] text-anthracite/85">{w.text}</p>
              <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                {w.file && (
                  <a href={w.file} download class="inline-flex items-center gap-1.5 font-bold text-bleu hover:underline">
                    <Icon name="download" size={16} /> {c.download}
                  </a>
                )}
                <a href={w.page} class="font-bold text-bleu hover:underline">{w.file ? (fr ? 'Présentation' : 'Overview') : c.bookLink}</a>
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} title={c.ctaTitle} text={c.ctaText} />
</BaseLayout>

<script>
  // Lecture de la maison : l'étage dont l'explication traverse le milieu de l'écran reste net.
  const maison = document.querySelector<HTMLElement>('[data-maison]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-house-row]')];
  if (maison && rows.length && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const update = () => {
      const current = rows.filter((r) => visible.has(r.dataset.houseRow!)).pop();
      if (current) maison.dataset.active = current.dataset.houseRow;
      else delete maison.dataset.active;
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const id = (e.target as HTMLElement).dataset.houseRow!;
          if (e.isIntersecting) visible.add(id);
          else visible.delete(id);
        });
        update();
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    rows.forEach((r) => observer.observe(r));
  }
</script>
