---
/**
 * PAGE CONSEIL (FR « /conseil/ », EN « /en/consulting/ »)
 * Deux métiers visibles dès l'ouverture : Lean Flux Usine et Lean Flux Supply Chain.
 * #usine        : la VSM expliquée simplement, leviers, livrables
 * #supply-chain : flux logistiques et focus Supply Chain Risk Management
 * #vsm-express  : l'offre d'entrée et sa FAQ
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import VsmExpressOffer from '@/components/VsmExpressOffer.astro';
import BottleneckChart from '@/components/BottleneckChart.astro';
import Icon from '@/components/ui/Icon.astro';
import { plantLine, supplyLine, vsmExplained, scrmSteps, vsmExpress } from '@/data/offers';
import { site } from '@/config/site';
import { routes, type Lang } from '@/i18n/routes';
import { anchorId, anchorPath } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';

const c = {
  fr: {
    title: 'Conseil Lean : Lean Flux Usine et Lean Flux Supply Chain',
    description:
      "Deux métiers : le Lean appliqué à l'usine, avec la VSM pour point de départ, et le Lean appliqué à la supply chain, avec un focus sur la gestion des risques (SCRM). Diagnostic VSM Express 100 % déductible.",
    crumb: 'Conseil',
    h1: 'Deux métiers, une même méthode : suivre le flux',
    lead: "De l'atelier au réseau de fournisseurs, on part du terrain, on mesure où le produit attend, et on construit avec vos équipes un flux qu'elles sauront faire vivre seules.",
    discover: 'Découvrir',
    symptoms: 'Vous reconnaissez la situation',
    levers: 'Nos leviers',
    deliverables: 'Ce que vous obtenez',
    vsmTitle: 'La VSM expliquée simplement',
    vsmBenefits: 'Trois bénéfices',
    vsmSteps: 'Concrètement, trois étapes avec vos équipes',
    vsmCta: 'Demander un Diagnostic VSM Express',
    factbird: 'Mesurer le TRS en continu, ligne par ligne, avec notre partenaire Factbird.',
    factbirdCta: 'Factbird OEE',
    scrmTitle: 'Focus : Supply Chain Risk Management',
    scrmLead: "Une chaîne logistique tendue est efficace… jusqu'au jour où un maillon casse. La gestion des risques consiste à savoir à l'avance où elle cassera, ce que cela coûtera, et ce qui est prêt pour y faire face.",
    experience: 'Une expérience vécue',
    experienceText: "Manuel Gourmand a piloté une supply chain internationale depuis le Brésil : pour nous, la gestion des risques n'est pas un exercice théorique.",
    supplyCta: 'Parler de votre supply chain',
    methodTitle: 'Notre démarche, quel que soit le métier',
    method: [
      { title: 'Mesurer', text: 'Marche terrain, cartographie du flux réel, données collectées sur place plutôt que supposées.' },
      { title: 'Co-construire', text: 'L’état futur se dessine avec ceux qui feront le travail, pas pour eux.' },
      { title: 'Expérimenter', text: 'Des chantiers courts, sur un périmètre pilote, pour prouver avant de généraliser.' },
      { title: 'Ancrer', text: 'Standards, rituels et indicateurs transmis : votre encadrement reprend la main.' },
    ],
    vsmExpressTitle: 'Pour commencer : le Diagnostic VSM Express',
    faqTitle: 'Questions fréquentes',
  },
  en: {
    title: 'Lean consulting: Lean Plant Flow and Lean Supply Chain Flow',
    description:
      'Two lines of work: Lean applied to the plant, starting from value stream mapping, and Lean applied to the supply chain, with a focus on supply chain risk management (SCRM). 100% deductible VSM Express Diagnostic.',
    crumb: 'Consulting',
    h1: 'Two lines of work, one method: follow the flow',
    lead: 'From the workshop to the supplier network, we start on the ground, measure where the product waits, and build with your teams a flow they can sustain on their own.',
    discover: 'Discover',
    symptoms: 'Sound familiar?',
    levers: 'Our levers',
    deliverables: 'What you get',
    vsmTitle: 'Value stream mapping, explained simply',
    vsmBenefits: 'Three benefits',
    vsmSteps: 'In practice, three steps with your teams',
    vsmCta: 'Request a VSM Express Diagnostic',
    factbird: 'Measure OEE continuously, line by line, with our partner Factbird.',
    factbirdCta: 'Factbird OEE',
    scrmTitle: 'Focus: Supply Chain Risk Management',
    scrmLead: 'A lean supply chain is efficient… until the day a link breaks. Risk management means knowing in advance where it will break, what it will cost, and what is ready to cope.',
    experience: 'First-hand experience',
    experienceText: 'Manuel Gourmand ran an international supply chain from Brazil: for us, risk management is not a theoretical exercise.',
    supplyCta: 'Talk about your supply chain',
    methodTitle: 'Our approach, whatever the line of work',
    method: [
      { title: 'Measure', text: 'Gemba walk, real-flow mapping, data collected on site rather than assumed.' },
      { title: 'Co-design', text: 'The future state is designed with the people who will do the work, not for them.' },
      { title: 'Experiment', text: 'Short workshops on a pilot scope, to prove before rolling out.' },
      { title: 'Embed', text: 'Standards, routines and KPIs handed over: your managers take back control.' },
    ],
    vsmExpressTitle: 'To get started: the VSM Express Diagnostic',
    faqTitle: 'Frequently asked questions',
  },
}[lang];

const lines = [
  { line: plantLine, anchor: 'usine' as const, band: 'border-t-bleu', accent: 'text-bleu' },
  { line: supplyLine, anchor: 'supply' as const, band: 'border-t-turquoise', accent: 'text-turquoise-fonce' },
];

const jsonLd = [
  ...[plantLine, supplyLine].map((line) => ({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: line.title[lang],
    description: line.tagline[lang],
    provider: { '@id': `${site.url}/#organization` },
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: fr ? 'Diagnostic VSM Express' : 'VSM Express Diagnostic',
    serviceType: 'Value Stream Mapping',
    provider: { '@id': `${site.url}/#organization` },
    offers: {
      '@type': 'Offer',
      price: vsmExpress.priceHT,
      priceCurrency: 'EUR',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: vsmExpress.priceHT, priceCurrency: 'EUR', valueAddedTaxIncluded: false },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: vsmExpress.faq[lang].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout lang={lang} routeKey="consulting" title={c.title} description={c.description} jsonLd={jsonLd}>
  <!-- Les deux métiers, visibles dès l'ouverture -->
  <section class="border-b border-bordure bg-zebra">
    <div class="container-pl py-12 md:py-16">
      <nav aria-label={fr ? "Fil d'Ariane" : 'Breadcrumb'} class="mb-5 text-sm text-gris">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={routes.home[lang]} class="hover:text-bleu hover:underline">{fr ? 'Accueil' : 'Home'}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-bold text-anthracite">{c.crumb}</li>
        </ol>
      </nav>
      <h1 class="max-w-[24ch] text-4xl font-bold tracking-tight text-bleu sm:text-5xl">{c.h1}</h1>
      <p class="lead mt-5">{c.lead}</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {lines.map(({ line, anchor, band, accent }) => (
          <a href={`#${anchorId(anchor, lang)}`} class:list={['group flex flex-col border border-bordure border-t-[8px] bg-white p-7 transition-colors hover:border-bleu md:p-8', band]}>
            <span class:list={['text-3xl font-bold tracking-tight md:text-4xl', accent]}>{line.title[lang]}</span>
            <span class="mt-3 text-lg font-bold text-anthracite">{line.tagline[lang]}</span>
            <span class="mt-3 text-anthracite/85">{line.deliverables[lang].join(' ; ')}.</span>
            <span class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-bleu group-hover:underline">
              {c.discover}
              <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LEAN FLUX USINE -->
  <section id={anchorId('usine', lang)} class="py-16 md:py-24" aria-labelledby="h-usine">
    <div class="container-pl">
      <div class="border-t-[6px] border-bleu pt-8">
        <h2 id="h-usine" class="text-4xl font-bold tracking-tight text-bleu md:text-5xl">{plantLine.title[lang]}</h2>
        <p class="mt-3 text-xl font-bold text-anthracite">{plantLine.tagline[lang]}</p>
        <p class="lead mt-5">{plantLine.intro[lang]}</p>
      </div>

      <!-- La VSM expliquée simplement -->
      <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div>
          <h3 class="text-2xl font-bold text-anthracite">{c.vsmTitle}</h3>
          <p class="mt-4 text-xl font-bold text-bleu">{vsmExplained.question[lang]}</p>
          <p class="mt-4 max-w-[60ch] text-anthracite/90">{vsmExplained.definition[lang]}</p>
          <div class="mt-7 grid grid-cols-2 gap-3">
            <div class="kpi-tile kpi-sun">
              <p class="kpi-value">{vsmExplained.example.lead[lang]}</p>
              <p class="text-[0.95rem]">{vsmExplained.example.leadLabel[lang]}</p>
            </div>
            <div class="kpi-tile kpi-turq">
              <p class="kpi-value">{vsmExplained.example.work[lang]}</p>
              <p class="text-[0.95rem]">{vsmExplained.example.workLabel[lang]}</p>
            </div>
          </div>
          <p class="mt-5 text-lg font-bold text-anthracite">{vsmExplained.example.conclusion[lang]}</p>
          <p class="mt-1 text-sm text-gris">{vsmExplained.example.note[lang]}</p>
        </div>
        <BottleneckChart lang={lang} />
      </div>

      <h3 class="mt-16 text-2xl font-bold text-anthracite">{c.vsmBenefits}</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {vsmExplained.benefits[lang].map((b) => (
          <div class="border-t-[3px] border-bleu bg-ciel p-6">
            <p class="text-2xl font-bold text-bleu">{b.title}</p>
            <p class="mt-2 text-anthracite/90">{b.text}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-16 text-2xl font-bold text-anthracite">{c.vsmSteps}</h3>
      <ol class="list-steps mt-6 grid gap-x-10 md:grid-cols-3 [&>li]:mb-6 [&>li+li]:mt-0">
        {vsmExplained.steps[lang].map((s) => (
          <li>
            <p class="text-lg font-bold text-anthracite">{s.title}</p>
            <p class="mt-1 text-anthracite/85">{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="mt-12 grid gap-10 lg:grid-cols-3">
        <div>
          <h3 class="text-lg font-bold text-anthracite">{c.symptoms}</h3>
          <ul class="list-square mt-4">{plantLine.symptoms[lang].map((s) => <li>{s}</li>)}</ul>
        </div>
        <div>
          <h3 class="text-lg font-bold text-anthracite">{c.levers}</h3>
          <ul class="list-square mt-4">{plantLine.levers[lang].map((s) => <li>{s}</li>)}</ul>
          <p class="mt-5 flex items-start gap-2 text-[0.95rem]">
            <Icon name="bolt" size={18} class="mt-0.5 text-soleil" />
            <span>{c.factbird} <a href={anchorPath('partners', 'factbird', lang)} class="link-pl">{c.factbirdCta}</a></span>
          </p>
        </div>
        <div class="callout callout-blue self-start">
          <p class="callout-head">{c.deliverables}</p>
          <div class="callout-body">
            <ul class="list-square">{plantLine.deliverables[lang].map((s) => <li>{s}</li>)}</ul>
            <a href={`#${anchorId('vsmExpress', lang)}`} class="btn btn-primary mt-6 !whitespace-normal">{c.vsmCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAN FLUX SUPPLY CHAIN -->
  <section id={anchorId('supply', lang)} class="border-y border-bordure bg-zebra py-16 md:py-24" aria-labelledby="h-supply">
    <div class="container-pl">
      <div class="border-t-[6px] border-turquoise pt-8">
        <h2 id="h-supply" class="text-4xl font-bold tracking-tight text-turquoise-fonce md:text-5xl">{supplyLine.title[lang]}</h2>
        <p class="mt-3 text-xl font-bold text-anthracite">{supplyLine.tagline[lang]}</p>
        <p class="lead mt-5">{supplyLine.intro[lang]}</p>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <div>
          <h3 class="text-lg font-bold text-anthracite">{c.symptoms}</h3>
          <ul class="list-square mt-4">{supplyLine.symptoms[lang].map((s) => <li>{s}</li>)}</ul>
        </div>
        <div>
          <h3 class="text-lg font-bold text-anthracite">{c.levers}</h3>
          <ul class="list-square mt-4">{supplyLine.levers[lang].map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>

      <div class="mt-14 border border-bordure bg-white p-6 md:p-10">
        <h3 class="text-3xl font-bold tracking-tight text-bleu">{c.scrmTitle}</h3>
        <p class="mt-4 max-w-[68ch] text-lg">{c.scrmLead}</p>
        <ol class="list-steps mt-10 grid gap-x-8 md:grid-cols-2 lg:grid-cols-5 [&>li]:mb-6 [&>li+li]:mt-0">
          {scrmSteps[lang].map((s) => (
            <li>
              <p class="text-lg font-bold text-anthracite">{s.title}</p>
              <p class="mt-1 text-[0.97rem] text-anthracite/85">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1.1fr]">
        <div class="border-l-4 border-soleil bg-creme p-6">
          <p class="font-bold text-soleil-fonce">{c.experience}</p>
          <p class="mt-2 text-lg">{c.experienceText}</p>
        </div>
        <div class="callout callout-turq">
          <p class="callout-head">{c.deliverables}</p>
          <div class="callout-body">
            <ul class="list-square">{supplyLine.deliverables[lang].map((s) => <li>{s}</li>)}</ul>
            <a href={anchorPath('contact', 'form', lang, '?sujet=lean-flux-supply-chain')} class="btn btn-primary mt-6">{c.supplyCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DÉMARCHE -->
  <section class="py-16 md:py-20" aria-labelledby="h-demarche">
    <div class="container-pl">
      <h2 id="h-demarche" class="section-title">{c.methodTitle}</h2>
      <ol class="list-steps mt-10 grid gap-x-10 md:grid-cols-2 lg:grid-cols-4 [&>li]:mb-8 [&>li+li]:mt-0">
        {c.method.map((m) => (
          <li>
            <p class="text-lg font-bold text-anthracite">{m.title}</p>
            <p class="mt-1 text-anthracite/85">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- DIAGNOSTIC VSM EXPRESS -->
  <section id={anchorId('vsmExpress', lang)} class="border-t border-bordure bg-zebra py-16 md:py-24" aria-labelledby="h-vsm-express">
    <div class="container-pl">
      <h2 id="h-vsm-express" class="section-title">{c.vsmExpressTitle}</h2>
      <div class="mt-10">
        <VsmExpressOffer lang={lang} variant="full" headingLevel="h3" />
      </div>
      <h3 class="mt-16 text-2xl font-bold text-anthracite">{c.faqTitle}</h3>
      <div class="mt-6 divide-y divide-bordure border-y border-bordure bg-white">
        {vsmExpress.faq[lang].map((f) => (
          <details class="group px-5 py-4 md:px-7">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-anthracite [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="text-2xl leading-none text-bleu transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 max-w-[70ch] text-anthracite/85">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
