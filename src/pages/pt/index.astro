---
/**
 * Página em português (PT/BR), atteinte depuis le lien discret du footer.
 * Page unique de présentation ; menus et pied de page restent en anglais.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { routes, anchors } from '@/i18n/routes';
import { formatPrice } from '@/i18n/utils';
import { vsmExpress } from '@/data/offers';

const abs = (p: string) => new URL(p, site.url).href;
const alternates = [
  { hreflang: 'pt', href: abs('/pt/') },
  { hreflang: 'fr-FR', href: abs(routes.home.fr) },
  { hreflang: 'en-GB', href: abs(routes.home.en) },
  { hreflang: 'x-default', href: abs(routes.home.fr) },
];

const lines = [
  {
    title: 'Lean Flux Usine',
    text: 'O Lean aplicado à fábrica, a partir do mapeamento do fluxo de valor (VSM): fluxo puxado, SMED, TPM, acompanhamento do OEE em tempo real.',
    band: 'border-t-bleu',
  },
  {
    title: 'Lean Flux Supply Chain',
    text: 'O Lean aplicado à cadeia de suprimentos, com foco na gestão de riscos (SCRM): mapeamento da rede, criticidade dos fornecedores, planos de continuidade, S&OP.',
    band: 'border-t-turquoise',
  },
];
const more = [
  { title: 'Treinamentos', text: 'Cursos operacionais construídos a partir dos seus casos reais.' },
  { title: 'Serious Games', text: 'The Beer Game, The Lean Café montado no hall da sua empresa, gestão de crise para diretoria, DISC-Joker.' },
  { title: 'Phi-Lean Press', text: 'Livros e artigos sobre Lean, cadeia de suprimentos e inteligência artificial.' },
];
const contact = routes.contact.en + '#' + anchors.form.en;
---
<BaseLayout
  lang="en"
  htmlLang="pt"
  alternates={alternates}
  title="Phi-Lean – Consultoria e treinamento Lean: fábrica e cadeia de suprimentos"
  description="Consultoria e treinamento em Lean para fábricas, serviços e cadeias de suprimentos. Engenheiro ENIM, MSc Lean Enterprise (University of Buckingham), experiência de integração e partida de fábricas no Brasil. Atendimento em português, inglês e francês."
>
  <section class="border-b border-bordure bg-zebra">
    <div class="container-pl grid gap-12 py-16 md:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div>
        <h1 class="max-w-[22ch] text-4xl font-bold tracking-tight text-bleu sm:text-5xl lg:text-6xl">
          Lean que se sustenta depois que o consultor vai embora.
        </h1>
        <div class="stripe-tri mt-7 w-36" aria-hidden="true"></div>
        <p class="lead mt-7">
          A Phi-Lean otimiza os fluxos da fábrica, dos serviços e da cadeia de suprimentos, com o pragmatismo de quem dirigiu um
          site industrial e a exigência de quem ensina esses métodos em escolas de negócios e de engenharia.
        </p>
        <p class="mt-6 inline-block border-l-4 border-turquoise bg-menthe px-4 py-3 text-lg font-bold text-turquoise-fonce">
          Atendimento em português, inglês e francês.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={contact} class="btn btn-primary">Fale conosco</a>
          <a href={`mailto:${site.email}`} class="btn btn-secondary">{site.email}</a>
        </div>
        <p class="mt-6 text-[0.95rem] text-gris">
          Outras línguas: <a href={routes.home.fr} lang="fr" class="link-pl">site em francês</a> ou{' '}
          <a href={routes.home.en} lang="en" class="link-pl">em inglês</a>.
        </p>
      </div>
      <figure class="m-0 max-w-sm">
        <img src={site.founder.photo} alt="Manuel Gourmand, fundador da Phi-Lean" width="800" height="1000" class="aspect-[4/5] w-full object-cover" />
        <figcaption class="mt-3 text-sm text-gris">Manuel Gourmand, fundador da Phi-Lean</figcaption>
      </figure>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-pl">
      <h2 class="section-title">Uma experiência vivida no Brasil</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="border-t-[6px] border-bleu bg-ciel p-7">
          <p class="text-xl font-bold text-bleu">Integração de fábrica</p>
          <p class="mt-2 text-lg">Em Passo Fundo (RS), Manuel Gourmand conduziu a integração ao grupo de uma fábrica de máquinas agrícolas recém-adquirida (Kuhn do Brasil, grupo Bucher Industries).</p>
        </div>
        <div class="border-t-[6px] border-turquoise bg-menthe p-7">
          <p class="text-xl font-bold text-turquoise-fonce">Partida de uma nova fábrica</p>
          <p class="mt-2 text-lg">Como responsável interino da supply chain da região latino-americana de um grupo internacional, acompanhou a partida de uma nova fábrica em Indaiatuba (SP).</p>
        </div>
      </div>
      <p class="mt-8 max-w-[70ch] text-lg">
        Engenheiro formado pela ENIM (Metz), com intercâmbio na UNICAMP (Campinas), e titular de um MSc em Lean Enterprise pela
        University of Buckingham, ele fala português fluentemente. Quinze anos de direção industrial e de supply chain na
        França, no Reino Unido, nos Países Baixos, no Brasil e nos Estados Unidos.
        <a href={site.founder.linkedin} target="_blank" rel="noopener" class="link-pl">Perfil LinkedIn</a>
      </p>

      <h2 class="section-title mt-20">Dois ofícios, um mesmo método: seguir o fluxo</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {lines.map((l) => (
          <div class:list={['border border-bordure border-t-[8px] bg-white p-7', l.band]}>
            <h3 class="text-3xl font-bold tracking-tight text-bleu">{l.title}</h3>
            <p class="mt-3 text-lg">{l.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {more.map((m) => (
          <div class="border-l-4 border-turquoise pl-5">
            <h3 class="text-lg font-bold text-anthracite">{m.title}</h3>
            <p class="mt-1 text-anthracite/85">{m.text}</p>
          </div>
        ))}
      </div>

      <div class="callout callout-sun mt-16">
        <p class="callout-head">Oferta de entrada</p>
        <div class="callout-body">
          <h2 class="text-3xl font-bold text-bleu">Diagnóstico VSM Express</h2>
          <p class="mt-4 max-w-[60ch] text-lg">
            Em {vsmExpress.days} dias no local, mapeamos um dos seus fluxos com as suas equipes, medimos onde o tempo se perde e
            quantificamos os ganhos possíveis. Preço fixo de {formatPrice(vsmExpress.priceHT, 'fr')} (sem impostos), 100 % dedutível
            da missão seguinte.
          </p>
          <a href={`${routes.contact.en}?sujet=vsm-express#${anchors.form.en}`} class="btn btn-primary mt-6">Solicitar o diagnóstico</a>
        </div>
      </div>

      <p class="mt-12 text-[0.95rem] text-gris">
        Bases: {site.offices.map((o) => `${o.city} (${o.region.en})`).join(' e ')}.
      </p>
    </div>
  </section>
</BaseLayout>
