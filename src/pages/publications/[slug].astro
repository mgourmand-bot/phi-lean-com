---
/** Page de chaque livre ou article, en français (/publications/<id>/). */
import PublicationPage from '@/views/PublicationPage.astro';
import { publications } from '@/data/publications';

export function getStaticPaths() {
  return publications.map((p) => ({ params: { slug: p.id }, props: { id: p.id } }));
}
const { id } = Astro.props;
---
<PublicationPage lang="fr" id={id} />
