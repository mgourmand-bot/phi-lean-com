---
/** Page introuvable, bilingue. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routes } from '@/i18n/routes';
---
<BaseLayout
  lang="fr"
  title="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>
  <section class="py-24 md:py-32">
    <div class="container-pl max-w-3xl">
      <p class="text-7xl font-bold text-bordure">404</p>
      <h1 class="mt-4 text-4xl font-bold text-bleu">Cette page n'existe pas ou a été déplacée.</h1>
      <p class="mt-4 text-lg">Le flux s'est interrompu ici. Reprenez depuis l'accueil ou contactez-nous.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={routes.home.fr} class="btn btn-primary">Retour à l'accueil</a>
        <a href={routes.contact.fr} class="btn btn-secondary">Nous contacter</a>
      </div>
      <div lang="en" class="mt-14 border-t border-bordure pt-8">
        <h2 class="text-2xl font-bold text-anthracite">This page does not exist or has moved.</h2>
        <p class="mt-3">
          <a href={routes.home.en} class="link-pl">Go to the English home page</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
