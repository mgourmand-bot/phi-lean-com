# ------------------------------------------------------------------
# Phi-Lean – variables d'environnement (copier en .env puis compléter)
# Toutes sont publiques (préfixe PUBLIC_) : elles finissent dans le HTML.
# Ne jamais mettre ici une clé secrète Stripe (sk_...).
# ------------------------------------------------------------------

# Formulaires : URL Formspree (https://formspree.io/f/xxxx) OU URL de webhook
# (Make, n8n, Zapier...). Les données sont envoyées en multipart/form-data.
PUBLIC_FORM_CONTACT=
PUBLIC_FORM_CAREERS=
PUBLIC_FORM_WHITEPAPER=

# Prise de rendez-vous
PUBLIC_CALENDLY_URL=https://calendly.com/phi-lean/30min

# Stripe Checkout via Payment Links (https://buy.stripe.com/...)
# Laisser vide : le bouton bascule vers le formulaire de contact pré-rempli.
PUBLIC_STRIPE_BEERGAME_KIT=
PUBLIC_STRIPE_BEERGAME_PRINTPLAY=
PUBLIC_STRIPE_COFFEESHOP_KIT=
PUBLIC_STRIPE_COFFEESHOP_PRINTPLAY=
