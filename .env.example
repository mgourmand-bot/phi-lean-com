# ------------------------------------------------------------------
# Phi-Lean – variables d'environnement (copier en .env puis compléter)
# Toutes sont publiques (préfixe PUBLIC_) : elles finissent dans le HTML.
# Ne jamais mettre ici une clé secrète Stripe (sk_...).
# ------------------------------------------------------------------

# Formulaires : adresse qui reçoit les demandes (mode d'emploi : README).
PUBLIC_FORM_RECIPIENT=manuel@phi-lean.com
# Service d'envoi : formsubmit (par défaut, aucune clé) ou web3forms.
PUBLIC_FORM_PROVIDER=formsubmit
# Clé d'accès Web3Forms (https://web3forms.com, gratuite) : utilisée seulement
# si PUBLIC_FORM_PROVIDER=web3forms.
PUBLIC_WEB3FORMS_KEY=
# Mettre true seulement avec l'offre Web3Forms Pro (pièces jointes : CV).
PUBLIC_WEB3FORMS_PRO=false

# Prise de rendez-vous : page Calendly (valeur par défaut déjà réglée dans
# src/config/site.ts). À renseigner seulement pour en changer.
PUBLIC_CALENDLY_URL=https://calendly.com/manuel-phi-lean

# Stripe Checkout via Payment Links (https://buy.stripe.com/...)
# Laisser vide : le bouton bascule vers le formulaire de contact pré-rempli.
PUBLIC_STRIPE_BEERGAME_KIT=
PUBLIC_STRIPE_BEERGAME_PRINTPLAY=
PUBLIC_STRIPE_LEANCAFE_KIT=
PUBLIC_STRIPE_LEANCAFE_PRINTPLAY=
